+ return [{key:F.person,value:{key:who,name}},{key:F.hours,value:hours},{key:F.period,value:{start_time:{timestamp:at(start)},end_time:{timestamp:at(end)}}},{key:F.registration,value:reg},{key:'group_uuid',value:rid}];
