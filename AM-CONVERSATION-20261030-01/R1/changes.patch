+        return '准备采用这条项目反馈：'+title+'\n'+self.content(r)+'\n适用范围：仅在你当前私聊的该项目中使用，不自动分享给其他同事；不写正式台账、不代表专业验收。'
+    def adopt(self,ctx,args,key):
+        self.b.authorize(ctx,'execute',args);action=self.b.store.get_action(ctx,key)
