+    def _read_projects(self, row: dict) -> list[dict]:
+        try:
+            return self.service.query_projects(row)
+        except Exception as exc:
+            if type(exc).__name__ != "SourceLoading" or str(exc) != "SOURCE_LOADING":
+                raise
