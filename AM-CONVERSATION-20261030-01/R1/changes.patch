+        record=self.b.knowledge.approve(ctx,record['id'],record['version'])
+        return {'status':'succeeded','verified':record['status']=='approved','receipt_id':record['id'],'message':'已按所示范围采用这条反馈。原报告状态、正式台账和专业验收状态保持各自依据。'}
+    def register(self):
