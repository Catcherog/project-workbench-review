index 00000000..a65e071e
--- /dev/null
+++ b/am-conversation-r1/src/am_conversation/knowledge.py
@@ -0,0 +1,430 @@
+"""Scoped, versioned work knowledge with explicit owner approval.
+
+This module stores AM's own work records.  It has no access to account memories,
+external services, embeddings, or a language model.  Search uses local Chinese
+characters/bigrams and word matching; its score is not a confidence estimate.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import json
+import math
+from pathlib import Path
+import re
+import sqlite3
+import threading
+import time
+import unicodedata
+import uuid
+from collections.abc import Mapping
+from typing import Any, Callable, Iterator
+
+from .types import AccessContext, ConversationError, canonical
+
+
+KINDS = frozenset({"business", "rule", "fact", "case", "style"})
+SCOPES = frozenset({"tenant", "project", "private"})
+_HAN = re.compile(r"[\u3400-\u4dbf\u4e00-\u9fff]+")
+_WORDS = re.compile(r"[a-z0-9]+(?:[-_][a-z0-9]+)*")
+
+
+def _normalise(text: str) -> str:
+    return unicodedata.normalize("NFKC", text).casefold()
+
+
+def _terms(text: str) -> tuple[set[str], set[str], set[str]]:
+    spans = _HAN.findall(text)
+    characters = set("".join(spans))
+    bigrams = {span[i:i + 2] for span in spans for i in range(len(span) - 1)}
+    return set(_WORDS.findall(text)), characters, bigrams
+
+
+def _lexical_score(query: str, content: str) -> float:
+    """Return a lexical relevance score, never a semantic confidence value."""
+    query, content = _normalise(query), _normalise(content)
+    words, characters, bigrams = _terms(query)
+    content_words, content_characters, content_bigrams = _terms(content)
+    word_hits = words & content_words
+    character_hits = characters & content_characters
+    bigram_hits = bigrams & content_bigrams
+    phrase_hit = bool(query.strip()) and query.strip() in content
+    # A lone shared character in a longer query is usually Chinese stop-word
+    # noise.  Keep useful single-character queries and two-character overlap.
+    if not (phrase_hit or word_hits or bigram_hits or
+            (len(characters) == 1 and character_hits) or len(character_hits) >= 2):
+        return 0.0
+    return (12.0 * phrase_hit + 4.0 * len(word_hits) +
+            3.0 * len(bigram_hits) + 0.25 * len(character_hits) +
+            (len(word_hits) + len(bigram_hits)) / max(1, len(words) + len(bigrams)))
+
+
+class KnowledgeStore:
+    """SQLite knowledge store; all public reads reapply the current access scope.
+
+    ``owner_ids`` is trusted configuration keyed by ``(tenant_id, app_id)``.
+    Both membership in that configuration and the current ``ctx.is_owner``
+    capability are required for owner operations.  Owner status never widens
+    project or private-session visibility.
+
+    A submitted version is immutable.  A new candidate does not remove the old
+    approved version from search; approving the new version replaces it in one
+    transaction.  Only the latest submitted version can receive new approval.
+    """
+
+    def __init__(self, db_path: str | Path, *, owner_ids: Mapping | None = None,
+                 clock: Callable[[], float] = time.time) -> None:
+        self._owners: dict[tuple[str, str], frozenset[str]] = {}
+        for key, actors in (owner_ids or {}).items():
+            if (not isinstance(key, tuple) or len(key) != 2 or
+                    any(not isinstance(part, str) or not part for part in key) or
+                    isinstance(actors, str)):
+                raise ConversationError("INVALID_OWNER_CONFIGURATION")
+            try:
+                actor_set = frozenset(actors)
+            except TypeError as exc:
+                raise ConversationError("INVALID_OWNER_CONFIGURATION") from exc
+            if any(not isinstance(actor, str) or not actor for actor in actor_set):
+                raise ConversationError("INVALID_OWNER_CONFIGURATION")
+            self._owners[key] = actor_set
+        self._clock = clock
+        self._lock = threading.RLock()
+        self._closed = False
+        self._db = sqlite3.connect(str(db_path), timeout=5.0, isolation_level=None,
+                                   check_same_thread=False)
+        self._db.row_factory = sqlite3.Row
+        self._db.execute("PRAGMA busy_timeout = 5000")
+        self._db.execute("PRAGMA foreign_keys = ON")
+        self._db.execute("PRAGMA journal_mode = WAL")
+        self._db.executescript("""
+            CREATE TABLE IF NOT EXISTS knowledge_records (
+                id TEXT PRIMARY KEY,
+                tenant_id TEXT NOT NULL,
+                app_id TEXT NOT NULL,
+                logical_id TEXT NOT NULL,
+                version INTEGER NOT NULL CHECK (version >= 1),
+                kind TEXT NOT NULL CHECK (kind IN ('business','rule','fact','case','style')),
+                content TEXT NOT NULL,
+                source TEXT NOT NULL,
+                scope TEXT NOT NULL CHECK (scope IN ('tenant','project','private')),
+                status TEXT NOT NULL CHECK (status IN ('candidate','approved','rejected','superseded')),
+                project_id TEXT,
+                session_id TEXT,
+                actor_id TEXT NOT NULL,
+                created_at REAL NOT NULL,
+                approved_at REAL,
+                reviewed_at REAL,
+                reviewed_by TEXT,
+                UNIQUE (tenant_id, app_id, logical_id, version),
+                CHECK ((scope = 'tenant' AND project_id IS NULL AND session_id IS NULL)
+                    OR (scope = 'project' AND project_id IS NOT NULL AND session_id IS NULL)
+                    OR (scope = 'private' AND session_id IS NOT NULL))
+            );
+            CREATE UNIQUE INDEX IF NOT EXISTS knowledge_active_version
+                ON knowledge_records (tenant_id, app_id, logical_id)
+                WHERE status = 'approved';
+            CREATE INDEX IF NOT EXISTS knowledge_visibility
+                ON knowledge_records (tenant_id, app_id, status, scope, project_id, session_id);
+        """)
+
+    def close(self) -> None:
+        with self._lock:
+            if not self._closed:
+                self._db.close()
+                self._closed = True
+
+    def __enter__(self) -> KnowledgeStore:
+        self._ensure_open()
+        return self
+
+    def __exit__(self, *_: Any) -> None:
+        self.close()
+
+    def _ensure_open(self) -> None:
+        if self._closed:
+            raise ConversationError("KNOWLEDGE_STORE_CLOSED")
+
+    def _now(self) -> float:
+        value = self._clock()
+        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+            raise ConversationError("INVALID_CLOCK")
+        return float(value)
+
+    def _is_owner(self, ctx: AccessContext) -> bool:
+        return ctx.is_owner and ctx.actor_id in self._owners.get((ctx.tenant_id, ctx.app_id), ())
+
+    def _require_owner(self, ctx: AccessContext) -> None:
+        if not self._is_owner(ctx):
+            raise ConversationError("KNOWLEDGE_OWNER_REQUIRED")
+
+    @contextmanager
+    def _transaction(self) -> Iterator[None]:
+        with self._lock:
+            self._ensure_open()
+            savepoint = "knowledge_" + uuid.uuid4().hex if self._db.in_transaction else None
+            self._db.execute(f"SAVEPOINT {savepoint}" if savepoint else "BEGIN IMMEDIATE")
+            try:
+                yield
+                self._db.execute(f"RELEASE SAVEPOINT {savepoint}" if savepoint else "COMMIT")
+            except BaseException:
+                if savepoint:
+                    self._db.execute(f"ROLLBACK TO SAVEPOINT {savepoint}")
+                    self._db.execute(f"RELEASE SAVEPOINT {savepoint}")
+                else:
+                    self._db.execute("ROLLBACK")
+                raise
+
+    @staticmethod
+    def _record(row: sqlite3.Row) -> dict[str, Any]:
+        record = dict(row)
+        record["source"] = json.loads(record["source"])
+        return record
+
+    @staticmethod
+    def _version(expected_version: int) -> None:
+        if type(expected_version) is not int or expected_version < 1:
+            raise ConversationError("INVALID_KNOWLEDGE_VERSION")
+
+    @staticmethod
+    def _limit(limit: int, maximum: int) -> None:
+        if type(limit) is not int or not 1 <= limit <= maximum:
+            raise ConversationError("INVALID_KNOWLEDGE_LIMIT")
+
+    @staticmethod
+    def _source(source: dict[str, Any]) -> str:
+        if not isinstance(source, dict):
+            raise ConversationError("INVALID_KNOWLEDGE_SOURCE")
+        for field in ("uri", "observed_at"):
+            if not isinstance(source.get(field), str) or not source[field].strip():
+                raise ConversationError("INVALID_KNOWLEDGE_SOURCE")
+        try:
+            encoded = canonical(source)
+        except (TypeError, ValueError) as exc:
+            raise ConversationError("INVALID_KNOWLEDGE_SOURCE") from exc
+        if len(encoded) > 65536:
+            raise ConversationError("INVALID_KNOWLEDGE_SOURCE")
+        return encoded
+
+    @staticmethod
+    def _check_project(ctx: AccessContext, project_id: str | None) -> None:
+        if project_id is not None:
+            if not isinstance(project_id, str) or not project_id or len(project_id) > 256:
+                raise ConversationError("INVALID_PROJECT")
+            if not ctx.can_access_project(project_id):
+                raise ConversationError("PROJECT_FORBIDDEN")
+
+    def _visibility(self, ctx: AccessContext, project_id: str | None = None,
+                    *, alias: str = "") -> tuple[str, list[Any]]:
+        """Build the complete ACL in SQL, before records can be ranked."""
+        self._check_project(ctx, project_id)
+        p = f"{alias}." if alias else ""
+        parameters: list[Any] = [ctx.tenant_id, ctx.app_id]
+        if project_id is not None:
+            project_clause = f"{p}project_id = ?"
+            project_parameters: list[Any] = [project_id]
+        elif ctx.all_projects:
+            project_clause = f"{p}project_id IS NOT NULL"
+            project_parameters = []
+        elif ctx.allowed_project_ids:
+            projects = sorted(ctx.allowed_project_ids)
+            project_clause = f"{p}project_id IN ({','.join('?' for _ in projects)})"
+            project_parameters = projects
+        else:
+            project_clause, project_parameters = "0", []
+        sql = (f"{p}tenant_id = ? AND {p}app_id = ? AND ("
+               f"{p}scope = 'tenant' OR ({p}scope = 'project' AND {project_clause}) OR "
+               f"({p}scope = 'private' AND {p}session_id = ? AND {p}actor_id = ? AND "
+               f"({p}project_id IS NULL OR {project_clause})))")
+        parameters.extend(project_parameters)
+        parameters.extend([ctx.session_id, ctx.actor_id])
+        parameters.extend(project_parameters)
+        return sql, parameters
+
+    def _visible_row(self, ctx: AccessContext, record_id: str) -> sqlite3.Row:
+        if not isinstance(record_id, str) or not record_id:
+            raise ConversationError("KNOWLEDGE_NOT_FOUND")
+        where, params = self._visibility(ctx)
+        row = self._db.execute(
+            f"SELECT * FROM knowledge_records WHERE id = ? AND {where}",
+            [record_id, *params],
+        ).fetchone()
+        if row is None:
+            raise ConversationError("KNOWLEDGE_NOT_FOUND")
+        # An unapproved tenant/project candidate must not leak through get(id).
+        if (row["status"] != "approved" and row["approved_at"] is None and
+                row["actor_id"] != ctx.actor_id and not self._is_owner(ctx)):
+            raise ConversationError("KNOWLEDGE_NOT_FOUND")
+        return row
+
+    def _validate_submission(self, ctx: AccessContext, *, kind: str, content: str,
+                             source: dict[str, Any], scope: str,
+                             project_id: str | None) -> str:
+        """Validate without writing; also used by the JSONL import dry-run."""
+        if not isinstance(kind, str) or not isinstance(scope, str) or kind not in KINDS or scope not in SCOPES:
+            raise ConversationError("INVALID_KNOWLEDGE_KIND_OR_SCOPE")
+        if not isinstance(content, str) or not content.strip() or len(content) > 100000:
+            raise ConversationError("INVALID_KNOWLEDGE_CONTENT")
+        if not self._is_owner(ctx) and (kind != "fact" or scope != "private"):
+            raise ConversationError("KNOWLEDGE_OWNER_REQUIRED")
+        self._check_project(ctx, project_id)
+        if (scope == "project" and project_id is None) or (scope == "tenant" and project_id is not None):
+            raise ConversationError("INVALID_KNOWLEDGE_SCOPE")
+        return self._source(source)
+
+    def submit(self, ctx: AccessContext, *, kind: str, content: str,
+               source: dict[str, Any], scope: str = "private",
+               project_id: str | None = None, logical_id: str | None = None,
+               expected_version: int | None = None) -> dict[str, Any]:
+        source_json = self._validate_submission(ctx, kind=kind, content=content,
+                                               source=source, scope=scope, project_id=project_id)
+        if logical_id is None and expected_version is not None:
+            raise ConversationError("INVALID_KNOWLEDGE_VERSION")
+        if logical_id is not None:
+            if not isinstance(logical_id, str) or not logical_id:
+                raise ConversationError("KNOWLEDGE_NOT_FOUND")
+            self._version(expected_version)  # type: ignore[arg-type]
+        session_id = ctx.session_id if scope == "private" else None
+        with self._transaction():
+            version = 1
+            if logical_id is not None:
+                latest = self._db.execute(
+                    "SELECT * FROM knowledge_records WHERE tenant_id=? AND app_id=? "
+                    "AND logical_id=? ORDER BY version DESC LIMIT 1",
+                    (ctx.tenant_id, ctx.app_id, logical_id),
+                ).fetchone()
+                if latest is None:
+                    raise ConversationError("KNOWLEDGE_NOT_FOUND")
+                # An owner cannot revise an inaccessible private conversation.
+                self._visible_row(ctx, latest["id"])
+                if latest["version"] != expected_version:
+                    raise ConversationError("STALE_KNOWLEDGE_VERSION")
+                if (latest["scope"], latest["project_id"], latest["session_id"], latest["kind"]) != (
+                        scope, project_id, session_id, kind):
+                    raise ConversationError("KNOWLEDGE_SCOPE_IMMUTABLE")
+                version = latest["version"] + 1
+            else:
+                logical_id = uuid.uuid4().hex
+            record_id = uuid.uuid4().hex
+            self._db.execute(
+                "INSERT INTO knowledge_records "
+                "(id,tenant_id,app_id,logical_id,version,kind,content,source,scope,status,"
+                "project_id,session_id,actor_id,created_at) VALUES (?,?,?,?,?,?,?,?,?,'candidate',?,?,?,?)",
+                (record_id, ctx.tenant_id, ctx.app_id, logical_id, version, kind,
+                 content, source_json, scope, project_id, session_id, ctx.actor_id, self._now()),
+            )
+            return self._record(self._visible_row(ctx, record_id))
+
+    def approve(self, ctx: AccessContext, record_id: str,
+                expected_version: int) -> dict[str, Any]:
+        self._require_owner(ctx)
+        self._version(expected_version)
+        with self._transaction():
+            row = self._visible_row(ctx, record_id)
+            if row["version"] != expected_version:
+                raise ConversationError("STALE_KNOWLEDGE_VERSION")
+            if row["status"] == "approved":
+                return self._record(row)
+            if row["status"] != "candidate":
+                raise ConversationError("KNOWLEDGE_NOT_CANDIDATE")
+            latest_version = self._db.execute(
+                "SELECT MAX(version) FROM knowledge_records WHERE tenant_id=? AND app_id=? AND logical_id=?",
+                (ctx.tenant_id, ctx.app_id, row["logical_id"]),
+            ).fetchone()[0]
+            if latest_version != expected_version:
+                raise ConversationError("STALE_KNOWLEDGE_VERSION")
+            # The unique partial index also enforces one approved version across
+            # independent processes.  Old candidates cannot later reappear.
+            self._db.execute(
+                "UPDATE knowledge_records SET status='superseded' WHERE tenant_id=? AND app_id=? "
+                "AND logical_id=? AND version<? AND status IN ('approved','candidate')",
+                (ctx.tenant_id, ctx.app_id, row["logical_id"], row["version"]),
+            )
+            reviewed_at = self._now()
+            self._db.execute(
+                "UPDATE knowledge_records SET status='approved',approved_at=?,reviewed_at=?,reviewed_by=? WHERE id=?",
+                (reviewed_at, reviewed_at, ctx.actor_id, record_id),
+            )
+            return self._record(self._visible_row(ctx, record_id))
+
+    def reject(self, ctx: AccessContext, record_id: str,
+               expected_version: int) -> dict[str, Any]:
+        self._require_owner(ctx)
+        self._version(expected_version)
+        with self._transaction():
+            row = self._visible_row(ctx, record_id)
+            if row["version"] != expected_version:
+                raise ConversationError("STALE_KNOWLEDGE_VERSION")
+            if row["status"] == "rejected":
+                return self._record(row)
+            if row["status"] != "candidate":
+                raise ConversationError("KNOWLEDGE_NOT_CANDIDATE")
+            self._db.execute(
+                "UPDATE knowledge_records SET status='rejected',reviewed_at=?,reviewed_by=? WHERE id=?",
+                (self._now(), ctx.actor_id, record_id),
+            )
+            return self._record(self._visible_row(ctx, record_id))
+
+    def get(self, ctx: AccessContext, record_id: str) -> dict[str, Any]:
+        with self._lock:
+            self._ensure_open()
+            return self._record(self._visible_row(ctx, record_id))
+
+    def search(self, ctx: AccessContext, query: str, *, project_id: str | None = None,
+               kinds: list[str] | tuple[str, ...] | set[str] | None = None,
+               limit: int = 6) -> list[dict[str, Any]]:
+        self._limit(limit, 100)
+        if not isinstance(query, str) or len(query) > 2000:
+            raise ConversationError("INVALID_KNOWLEDGE_QUERY")
+        kind_filter: list[str] | None = None
+        if kinds is not None:
+            if isinstance(kinds, str):
+                raise ConversationError("INVALID_KNOWLEDGE_KIND")
+            try:
+                kind_filter = sorted(set(kinds))
+            except (TypeError, ValueError) as exc:
+                raise ConversationError("INVALID_KNOWLEDGE_KIND") from exc
+            if any(kind not in KINDS for kind in kind_filter):
+                raise ConversationError("INVALID_KNOWLEDGE_KIND")
+            if not kind_filter:
+                return []
+        where, parameters = self._visibility(ctx, project_id)
+        where += " AND status = 'approved'"
+        if kind_filter is not None:
+            where += f" AND kind IN ({','.join('?' for _ in kind_filter)})"
+            parameters.extend(kind_filter)
+        with self._lock:
+            self._ensure_open()
+            # Filter visibility in SQL first; inaccessible content never reaches
+            # the lexical ranker, even when its text is a perfect query match.
+            rows = self._db.execute(
+                f"SELECT * FROM knowledge_records WHERE {where}", parameters,
+            ).fetchall()
+        ranked: list[dict[str, Any]] = []
+        for row in rows:
+            record = self._record(row)
+            title = record["source"].get("title", "")
+            text = record["content"] + (" " + title if isinstance(title, str) else "")
+            score = _lexical_score(query, text) if query.strip() else 0.0
+            if query.strip() and score <= 0:
+                continue
+            record["lexical_score"] = score
+            ranked.append(record)
+        ranked.sort(key=lambda record: (-record["lexical_score"], -record["created_at"], record["id"]))
+        return ranked[:limit]
+
+    def review_candidates(self, ctx: AccessContext, limit: int = 20) -> list[dict[str, Any]]:
+        self._limit(limit, 100)
+        where, parameters = self._visibility(ctx, alias="k")
+        where += (" AND k.status = 'candidate' AND NOT EXISTS (SELECT 1 FROM knowledge_records newer "
+                  "WHERE newer.tenant_id=k.tenant_id AND newer.app_id=k.app_id "
+                  "AND newer.logical_id=k.logical_id AND newer.version>k.version)")
+        if not self._is_owner(ctx):
+            where += " AND k.actor_id = ?"
+            parameters.append(ctx.actor_id)
+        parameters.append(limit)
+        with self._lock:
+            self._ensure_open()
+            rows = self._db.execute(
+                f"SELECT k.* FROM knowledge_records k WHERE {where} ORDER BY k.created_at DESC,k.id LIMIT ?",
+                parameters,
+            ).fetchall()
+            return [self._record(row) for row in rows]
diff --git a/am-conversation-r1/src/am_conversation/learning.py b/am-conversation-r1/src/am_conversation/learning.py
new file mode 100644
index 00000000..c8c7cd88
--- /dev/null
+++ b/am-conversation-r1/src/am_conversation/learning.py
@@ -0,0 +1,335 @@
+"""Bounded JSONL knowledge import with explicit governance and honest reports.
+
+The file supplies knowledge data only.  Identity, application, tenant, project
+permissions and approval capability always come from the trusted AccessContext
+and KnowledgeStore configuration supplied by the host.
+"""
+from __future__ import annotations
+
+from collections.abc import Iterable
+import json
+from pathlib import Path
+from typing import Any
+
+from .knowledge import KnowledgeStore
+from .types import AccessContext, ConversationError, canonical
+
+
+_FIELDS = frozenset({"item_key", "kind", "content", "source", "scope", "project_id"})
+_REQUIRED = frozenset({"item_key", "kind", "content", "source"})
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ConversationError("IMPORT_DUPLICATE_JSON_FIELD")
+        result[key] = value
+    return result
+
+
+def _invalid_constant(_value):
+    raise ConversationError("IMPORT_INVALID_JSON")
+
+
+class KnowledgeImporter:
+    """Import JSONL into a KnowledgeStore without trusting file-supplied roles.
+
+    ``import_jsonl(ctx, text_or_lines, namespace='default', approve=False,
+    dry_run=False)`` returns counts plus an individual result for every nonblank
+    line.  ``import_file`` reads a local UTF-8 file with bounded physical lines.
+    Approval is an explicit host argument and is still checked by KnowledgeStore.
+
+    An item_key identifies one logical object inside tenant/app/namespace.  The
+    key cannot silently change kind or visibility.  Importing content that has
+    already appeared in its history does not create another version or restore
+    a superseded version.  New content creates a candidate; the previously
+    approved version remains active unless explicit approval succeeds.
+
+    A dry-run performs SELECTs only on the live database.  It simulates earlier
+    lines in memory, including duplicate items in the same file.  Reported plans
+    are not reservations and can change if another process writes afterwards.
+    """
+
+    def __init__(self, store: KnowledgeStore, *, max_line_bytes: int = 65536,
+                 max_content_chars: int = 20000, max_items: int = 1000) -> None:
+        if (type(max_line_bytes) is not int or not 1024 <= max_line_bytes <= 1048576 or
+                type(max_content_chars) is not int or not 1 <= max_content_chars <= 100000 or
+                type(max_items) is not int or not 1 <= max_items <= 10000):
+            raise ConversationError("INVALID_IMPORT_LIMITS")
+        self.store = store
+        self.max_line_bytes = max_line_bytes
+        self.max_content_chars = max_content_chars
+        self.max_items = max_items
+
+    def import_file(self, ctx: AccessContext, path: str | Path, *, namespace: str = "default",
+                    approve: bool = False, dry_run: bool = False) -> dict[str, Any]:
+        try:
+            with Path(path).open("rb") as stream:
+                return self.import_jsonl(ctx, self._bounded_lines(stream), namespace=namespace,
+                                         approve=approve, dry_run=dry_run)
+        except OSError as exc:
+            raise ConversationError("IMPORT_FILE_UNAVAILABLE") from exc
+
+    def _bounded_lines(self, stream):
+        while True:
+            first = stream.readline(self.max_line_bytes + 1)
+            if not first:
+                return
+            # Drain an oversized physical line without holding it in memory.
+            if len(first) > self.max_line_bytes and not first.endswith(b"\n"):
+                tail = first
+                while tail and not tail.endswith(b"\n"):
+                    tail = stream.readline(self.max_line_bytes + 1)
+            yield first
+
+    def import_jsonl(self, ctx: AccessContext, text_or_lines: str | bytes | Iterable,
+                     *, namespace: str = "default", approve: bool = False,
+                     dry_run: bool = False) -> dict[str, Any]:
+        if (not isinstance(namespace, str) or not namespace.strip() or len(namespace) > 128 or
+                any(ord(char) < 32 for char in namespace) or
+                type(approve) is not bool or type(dry_run) is not bool):
+            raise ConversationError("INVALID_IMPORT_OPTIONS")
+        lines = text_or_lines.splitlines() if isinstance(text_or_lines, (str, bytes)) else text_or_lines
+        try:
+            iterator = iter(lines)
+        except TypeError as exc:
+            raise ConversationError("INVALID_IMPORT_INPUT") from exc
+        report: dict[str, Any] = {
+            "ok": True, "complete": True, "dry_run": dry_run,
+            "approve_requested": approve, "namespace": namespace,
+            "counts": {"created": 0, "updated": 0, "unchanged": 0, "approved": 0,
+                       "errors": 0, "warnings": 0, "skipped_blank": 0},
+            "planned": {"created": 0, "updated": 0, "approved": 0}, "results": [],
+        }
+        shadow: dict[str, dict[str, Any] | None] = {}
+        line_number = 0
+        while True:
+            try:
+                raw = next(iterator)
+            except StopIteration:
+                break
+            except Exception:
+                report["complete"] = False
+                self._error(report, line_number + 1, None, "IMPORT_STREAM_FAILED")
+                break
+            line_number += 1
+            item_key = None
+            if len(report["results"]) >= self.max_items:
+                if isinstance(raw, (str, bytes)) and not raw.strip() and len(raw) <= self.max_line_bytes:
+                    report["counts"]["skipped_blank"] += 1
+                    continue
+                report["complete"] = False
+                self._error(report, line_number, None, "IMPORT_ITEM_LIMIT")
+                break
+            try:
+                parsed = self._parse(raw, first_line=line_number == 1)
+                if parsed is None:
+                    report["counts"]["skipped_blank"] += 1
+                    continue
+                item_key = parsed["item_key"]
+                self.store._validate_submission(ctx, kind=parsed["kind"], content=parsed["content"],
+                                                source=parsed["source"], scope=parsed["scope"],
+                                                project_id=parsed["project_id"])
+                if approve:
+                    self.store._require_owner(ctx)
+                if dry_run:
+                    result = self._simulate(ctx, parsed, namespace, approve, shadow)
+                else:
+                    result = self._apply(ctx, parsed, namespace, approve)
+                result.update({"line": line_number, "item_key": item_key, "ok": True})
+                report["results"].append(result)
+                action = result["action"]
+                if action == "would_create":
+                    report["planned"]["created"] += 1
+                elif action == "would_update":
+                    report["planned"]["updated"] += 1
+                else:
+                    report["counts"][action] += 1
+                if result["approval_changed"]:
+                    report["planned" if dry_run else "counts"]["approved"] += 1
+                report["counts"]["warnings"] += len(result["warnings"])
+            except ConversationError as exc:
+                self._error(report, line_number, item_key, str(exc))
+                if str(exc) == "IMPORT_ITEM_LIMIT":
+                    break
+            except Exception:
+                # Do not echo database paths, file content or raw exception text.
+                self._error(report, line_number, item_key, "IMPORT_STORAGE_FAILED")
+        report["ok"] = report["complete"] and report["counts"]["errors"] == 0
+        report["processed"] = len(report["results"])
+        return report
+
+    @staticmethod
+    def _error(report, line, item_key, code):
+        report["counts"]["errors"] += 1
+        report["results"].append({"line": line, "item_key": item_key, "ok": False,
+                                  "action": "error", "error": code, "persisted": False})
+
+    def _parse(self, raw, *, first_line: bool):
+        if isinstance(raw, bytes):
+            if len(raw) > self.max_line_bytes:
+                raise ConversationError("IMPORT_LINE_TOO_LARGE")
+            try:
+                raw = raw.decode("utf-8-sig" if first_line else "utf-8")
+            except UnicodeDecodeError as exc:
+                raise ConversationError("IMPORT_INVALID_UTF8") from exc
+        elif isinstance(raw, str):
+            try:
+                if len(raw.encode("utf-8")) > self.max_line_bytes:
+                    raise ConversationError("IMPORT_LINE_TOO_LARGE")
+            except UnicodeEncodeError as exc:
+                raise ConversationError("IMPORT_INVALID_UTF8") from exc
+            if first_line:
+                raw = raw.removeprefix("\ufeff")
+        else:
+            raise ConversationError("IMPORT_INVALID_LINE")
+        if not raw.strip():
+            return None
+        try:
+            item = json.loads(raw, object_pairs_hook=_unique_object, parse_constant=_invalid_constant)
+        except (ValueError, RecursionError) as exc:
+            raise ConversationError("IMPORT_INVALID_JSON") from exc
+        if not isinstance(item, dict) or not _REQUIRED.issubset(item) or set(item) - _FIELDS:
+            raise ConversationError("IMPORT_INVALID_FIELDS")
+        key = item["item_key"]
+        if not isinstance(key, str) or not key.strip() or len(key) > 256 or any(ord(c) < 32 for c in key):
+            raise ConversationError("IMPORT_INVALID_ITEM_KEY")
+        if not isinstance(item["content"], str) or not item["content"].strip():
+            raise ConversationError("INVALID_KNOWLEDGE_CONTENT")
+        if len(item["content"]) > self.max_content_chars:
+            raise ConversationError("IMPORT_CONTENT_TOO_LARGE")
+        # Escaped lone surrogates are legal in Python's JSON decoder but cannot
+        # be stored in UTF-8 SQLite text.  Reject them as data, before any writes.
+        try:
+            canonical(item).encode("utf-8")
+        except (TypeError, ValueError, UnicodeEncodeError, RecursionError) as exc:
+            raise ConversationError("IMPORT_INVALID_JSON") from exc
+        return {**item, "scope": item.get("scope", "private"), "project_id": item.get("project_id")}
+
+    def _ensure_index(self):
+        self.store._db.execute("""
+            CREATE TABLE IF NOT EXISTS knowledge_import_items (
+                tenant_id TEXT NOT NULL,
+                app_id TEXT NOT NULL,
+                namespace TEXT NOT NULL,
+                item_key TEXT NOT NULL,
+                logical_id TEXT NOT NULL,
+                PRIMARY KEY (tenant_id, app_id, namespace, item_key)
+            )
+        """)
+
+    def _load(self, ctx, namespace, item_key):
+        exists = self.store._db.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='knowledge_import_items'"
+        ).fetchone()
+        if exists is None:
+            return None
+        mapping = self.store._db.execute(
+            "SELECT logical_id FROM knowledge_import_items WHERE tenant_id=? AND app_id=? "
+            "AND namespace=? AND item_key=?", (ctx.tenant_id, ctx.app_id, namespace, item_key),
+        ).fetchone()
+        if mapping is None:
+            return None
+        rows = self.store._db.execute(
+            "SELECT id FROM knowledge_records WHERE tenant_id=? AND app_id=? AND logical_id=? "
+            "ORDER BY version DESC", (ctx.tenant_id, ctx.app_id, mapping["logical_id"]),
+        ).fetchall()
+        if not rows:
+            raise ConversationError("IMPORT_INDEX_INVALID")
+        # Reuse the same visibility check as ordinary reads, including private
+        # sessions and permissions that have been reduced since a prior import.
+        history = [self.store._record(self.store._visible_row(ctx, row["id"])) for row in rows]
+        return {"history": history}
+
+    @staticmethod
+    def _plan(item, state, approve):
+        history = state["history"] if state else []
+        latest = history[0] if history else None
+        if latest and (latest["kind"], latest["scope"], latest["project_id"]) != (
+                item["kind"], item["scope"], item["project_id"]):
+            raise ConversationError("IMPORT_ITEM_DEFINITION_CHANGED")
+        match = next((record for record in history if record["content"] == item["content"]), None)
+        if match:
+            historical = match["version"] != latest["version"]
+            if approve and match["status"] != "approved":
+                if historical:
+                    raise ConversationError("IMPORT_HISTORICAL_VERSION")
+                if match["status"] != "candidate":
+                    raise ConversationError("KNOWLEDGE_NOT_CANDIDATE")
+            return {"action": "unchanged", "record": match, "latest": latest,
+                    "historical": historical,
+                    "approval_changed": approve and match["status"] == "candidate"}
+        return {"action": "updated" if latest else "created", "latest": latest,
+                "historical": False, "approval_changed": approve}
+
+    @staticmethod
+    def _result(item, plan, record, *, dry_run, new_record=False):
+        warnings = []
+        if plan["historical"]:
+            warnings.append("IMPORT_HISTORICAL_CONTENT_NOT_REAPPLIED")
+        if record["source"] != item["source"]:
+            warnings.append("IMPORT_UNCHANGED_SOURCE_RETAINED")
+        if record["status"] in {"rejected", "superseded"}:
+            warnings.append("IMPORT_RECORD_NOT_ACTIVE")
+        action = plan["action"]
+        if dry_run and action in {"created", "updated"}:
+            action = "would_create" if action == "created" else "would_update"
+        return {"action": action, "record_id": record["id"], "logical_id": record["logical_id"],
+                "version": record["version"], "status": None if dry_run and (record["id"] is None or new_record or plan["approval_changed"]) else record["status"],
+                "planned_status": record["status"] if dry_run else None,
+                "persisted": not dry_run, "approval_changed": plan["approval_changed"],
+                "historical": plan["historical"], "warnings": warnings}
+
+    def _apply(self, ctx, item, namespace, approve):
+        # One transaction covers the stable import mapping, version submission
+        # and any explicit approval.  A failed row cannot leave half an import.
+        with self.store._transaction():
+            self._ensure_index()
+            state = self._load(ctx, namespace, item["item_key"])
+            plan = self._plan(item, state, approve)
+            if plan["action"] == "unchanged":
+                record = plan["record"]
+            else:
+                latest = plan["latest"]
+                record = self.store.submit(
+                    ctx, kind=item["kind"], content=item["content"], source=item["source"],
+                    scope=item["scope"], project_id=item["project_id"],
+                    logical_id=latest["logical_id"] if latest else None,
+                    expected_version=latest["version"] if latest else None,
+                )
+                if latest is None:
+                    self.store._db.execute(
+                        "INSERT INTO knowledge_import_items (tenant_id,app_id,namespace,item_key,logical_id) "
+                        "VALUES (?,?,?,?,?)", (ctx.tenant_id, ctx.app_id, namespace, item["item_key"], record["logical_id"]),
+                    )
+            if plan["approval_changed"]:
+                record = self.store.approve(ctx, record["id"], record["version"])
+            return self._result(item, plan, record, dry_run=False)
+
+    def _simulate(self, ctx, item, namespace, approve, shadow):
+        key = item["item_key"]
+        if key not in shadow:
+            with self.store._lock:
+                self.store._ensure_open()
+                shadow[key] = self._load(ctx, namespace, key)
+        state = shadow[key]
+        plan = self._plan(item, state, approve)
+        history = [dict(record) for record in state["history"]] if state else []
+        new_record = plan["action"] != "unchanged"
+        if new_record:
+            latest = plan["latest"]
+            record = {"id": None, "logical_id": latest["logical_id"] if latest else None,
+                      "version": latest["version"] + 1 if latest else 1, "kind": item["kind"],
+                      "content": item["content"], "source": item["source"], "scope": item["scope"],
+                      "project_id": item["project_id"], "status": "candidate"}
+            history.insert(0, record)
+        else:
+            record = next(record for record in history if record["version"] == plan["record"]["version"])
+        if plan["approval_changed"]:
+            for older in history:
+                if older["version"] < record["version"] and older["status"] in {"approved", "candidate"}:
+                    older["status"] = "superseded"
+            record["status"] = "approved"
+        shadow[key] = {"history": history}
+        return self._result(item, plan, record, dry_run=True, new_record=new_record)
diff --git a/am-conversation-r1/src/am_conversation/legacy.py b/am-conversation-r1/src/am_conversation/legacy.py
new file mode 100644
index 00000000..4d813953
--- /dev/null
+++ b/am-conversation-r1/src/am_conversation/legacy.py
@@ -0,0 +1,497 @@
+"""Opt-in adapter for the original AM consumer, authorization and outbox.
+
+No transport, consumer, model provider, scheduler or external-action executor is
+created here.  The caller supplies an already constructed AmSelfService.  Its
+trusted inbox rows and current query grants are the only source of identity and
+project capabilities.
+"""
+from __future__ import annotations
+
+from contextvars import ContextVar
+from copy import deepcopy
+from dataclasses import asdict, replace
+from datetime import datetime
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+import time
+from typing import Any
+from zoneinfo import ZoneInfo
+
+from .engine import ConversationAgent, RuntimeConfig
+from .knowledge import KnowledgeStore
+from .model import CoordinatorModel
+from .store import ConversationStore
+from .tools import Tool, build_registry, obj, string
+from .types import AccessContext, AgentReply, ConversationError, canonical
+
+
+FAILURE_TEXT = "当前未能处理这条消息。请稍后重试，或联系管理员核对访问范围。"
+
+
+def _hash(value: Any) -> str:
+    return hashlib.sha256(canonical(value).encode()).hexdigest()
+
+
+def _encode_context(ctx: AccessContext) -> dict:
+    value = asdict(ctx)
+    value["allowed_project_ids"] = sorted(ctx.allowed_project_ids)
+    return value
+
+
+def _reply(value: dict) -> AgentReply:
+    return AgentReply(value["event_id"], value["text"], value.get("status", "answered"),
+                      value.get("replayed", False), tuple(value.get("pending_actions", [])),
+                      tuple(value.get("source_ids", [])))
+
+
+def _plain_text(text: str) -> str:
+    """Render possible Feishu mention tags inert, without changing tool data."""
+    return re.sub(r"<(?=/?at\b)", "＜", text, flags=re.IGNORECASE)
+
+
+class _PlainTextModel:
+    """Sanitize before the engine commits history, reply and delivery content."""
+    def __init__(self, model):
+        self.model = model
+
+    def complete(self, messages, tools, *, request_id=""):
+        turn = self.model.complete(messages, tools, request_id=request_id)
+        return replace(turn, text=_plain_text(turn.text))
+
+    def context_budget(self, tools):
+        return self.model.context_budget(tools)
+    def set_deadline(self,deadline):return self.model.set_deadline(deadline)
+    def reset_deadline(self,token):self.model.reset_deadline(token)
+
+
+class _LegacyProjects:
+    def __init__(self, bridge: "LegacyConversationBridge"):
+        self.bridge = bridge
+
+    def list_projects(self, ctx: AccessContext) -> list[dict]:
+        self.bridge.authorize(ctx, "read", {})
+        current = self.bridge._current(ctx)
+        rows = self.bridge._read_projects(current["row"])
+        return [self.bridge._project(row, current["row"]) for row in rows
+                if row.get("key") in ctx.allowed_project_ids]
+
+    def read_project(self, ctx: AccessContext, project_id: str) -> dict:
+        self.bridge.authorize(ctx, "read", {"project_id": project_id})
+        matches = [row for row in self.list_projects(ctx) if row["id"] == project_id]
+        if len(matches) != 1:
+            raise ConversationError("PROJECT_NOT_AVAILABLE")
+        result = matches[0]
+        self.bridge._current(ctx).setdefault('read_projects',set()).add(project_id)
+        information = getattr(self.bridge.service, 'information', None)
+        if information is not None:
+            current = self.bridge._current(ctx)
+            from .capabilities import information as project_information
+            result['information'] = project_information(self.bridge,ctx,{'project_id':project_id,'limit':3,'exclude_ledger':True},current['row']['id'])
+        return result
