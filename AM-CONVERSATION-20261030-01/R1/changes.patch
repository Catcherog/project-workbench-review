+        return {'report_id':r['id'],'version':r['version'],'state':r['state'],'facts':json.loads(r['facts']),'message':'已把这段原话纳入项目反馈，供本人和管理人核对；正式台账、计划及验收状态未修改。'}
+    def list(self,ctx,args,event):
