+    def item(self, key="rule.one", content="合成规则：验收前核查证据", **changes):
+        return {"item_key": key, "kind": "rule", "scope": "tenant", "content": content,
+                "source": {"uri": "synthetic://sample/rule", "observed_at": "2026-10-30T09:00:00+08:00",
+                           "version": "v1"}, **changes}
