+def atomic_json(path, value):
+    path = Path(path)
+    tmp = path.with_name(path.name + '.' + uuid.uuid4().hex + '.tmp')
+    tmp.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
+    tmp.chmod(0o600)
+    os.replace(tmp, path)
+
