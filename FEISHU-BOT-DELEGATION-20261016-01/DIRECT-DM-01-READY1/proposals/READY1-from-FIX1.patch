+  if(m.sender.sender_type==='app'){
+   if(m.sender.id_type==='app_id'&&senderId===b.appId)senderId=b.botId;
+   else if(m.sender.id_type!=='open_id'||senderId!==b.botId)fail('READBACK_BOT_INVALID');
