+def test_normalized_reporting_limits_keep_quotes_and_log_changes():
+    from fs_agent.doc_logic import normalize_limits
+    sources=[source("此输入没有图片像素。")]
+    v=candidate(sources,assessment="提交记录为非实测数据。")
