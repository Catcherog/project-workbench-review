+def fixture_native():
+    blocks=[{'block_id':'root','block_type':1,'parent_id':'','children':['name','background','title','body'],
+        'page':{'elements':[{'text_run':{'content':'Template'}}]}},
+        {'block_id':'name','block_type':2,'parent_id':'root','text':{'elements':[
