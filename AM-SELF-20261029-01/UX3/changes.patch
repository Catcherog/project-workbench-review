+READ_PAGES = frozenset(('home', 'projects', 'search', 'project', 'recent', 'refresh',
+                        'long_content', 'reconcile_navigation'))
+ENTRY_TEXT = frozenset(('/menu', '/am', '/project', '项目', '项目查询', '项目列表', '查看项目'))
