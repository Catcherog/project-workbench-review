+        if m['deleted'] or m['sender_id']!=self.g.config.bot_open_id or m['sender_type'] not in ('app','bot'):return False
+        t=payload['target'];private=t['kind']=='owner'
+        if not private and m['chat_id']!=t['payload']['group']['id']:return False
+        if private:
