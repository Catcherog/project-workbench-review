+def test_F04_definitely_deleted_navigation_is_rebuilt_once(ux):
+    request(ux, '/menu', 1); am, g, s, api, clock, _ = ux; old = latest(ux)['message_id']
+    del api.messages[old]; original = api.update_card
+    def deleted(row, guard):
