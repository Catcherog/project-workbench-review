+    for _ in range(30):
+        snap = json.loads(latest(ux)['snapshot']); pieces.append(snap['envelope']['summary'])
+        nxt = next((a for a in snap['actions'].values() if a['page'] == 'long_content' and a['offset'] > snap['data'].get('_long_index', 0)), None)
