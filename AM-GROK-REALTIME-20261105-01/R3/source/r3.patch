@@ -0,0 +1,140 @@
+"""Task-scoped tool port. Only effective when ALL executor tools are routed here.
+
+There is no assertion that the external Grok Bot currently uses this port.
+"""
+import json
+
+from ..models import ContractError, dumps, key
+from .contracts import Policy
+
+
+class ToolBoundary:
+    def _authorize(self, db, task_id, generation, *, require_running=True):
+        task = self.task(task_id, db)
+        policy = Policy.parse(task['policy_json'])
+        if policy.revoked or generation != task['generation']:
+            raise ContractError('revoked policy or old generation')
+        if task['last_error'] == 'source_changed' or task['verification_state'] == 'conflict':
+            raise ContractError('source or evidence changed')
+        source = db.execute('SELECT version,is_deleted,chat_id FROM gw_items WHERE item_id=?',(task['item_id'],)).fetchone()
+        if not source or source['is_deleted'] or source['version'] != task['source_version'] or source['chat_id'] not in policy.source_chats:
+            raise ContractError('request source is no longer usable')
+        session = db.execute('SELECT * FROM h1_sessions WHERE scope=?', (task['scope'],)).fetchone()
+        if require_running and (not session or session['task_id'] != task_id or session['generation'] != generation or session['state'] != 'held'):
+            raise ContractError('executor no longer owns this scope')
+        context = json.loads(task['context_json'] or '{}')
+        # Revocation and revision changes invalidate an already accepted snapshot.
+        for item in context.get('evidence_items', []):
+            row = db.execute('SELECT * FROM h1_info WHERE info_id=?', (item['info_id'],)).fetchone()
+            if not row or not self.information.allowed(db, row, policy):
+                raise ContractError('accepted context is no longer usable')
+        return task, policy
+
+    def read_information(self, task_id, generation, info_id):
+        with self.store.transaction() as db:
+            task, policy = self._authorize(db, task_id, generation)
+            row = db.execute('SELECT * FROM h1_info WHERE info_id=?', (info_id,)).fetchone()
+            if not row or not self.information.allowed(db, row, policy):
+                raise ContractError('read outside task scope')
+            return {n: row[n] for n in ('info_id','project','nature','body')}
+
+    def tool_action(self, task_id, generation, action, *, target='', body='', sender=None):
+        if action != 'reply':
+            raise ContractError('business writes and arbitrary tools are not connected')
+        return self._reply(task_id, generation, target, body, sender, executor=True)
+
+    def deliver_recorded_result(self, task_id, sender):
+        """Trusted delivery component, not an executor override for expired epochs."""
+        task = self.task(task_id)
+        result = json.loads(task['result_json'] or '{}')
+        if not result.get('reply_text') or task['execution_state'] not in {'succeeded','failed'}:
+            raise ContractError('no finished recorded answer')
+        return self._reply(task_id, task['generation'], Policy.parse(task['policy_json']).reply_target,
+                           result['reply_text'], sender, executor=False)
+
+    def _reply(self, task_id, generation, target, body, sender, *, executor):
+        if not isinstance(body, str) or not body.strip() or len(body.encode()) > 30000 or sender is None:
+            raise ContractError('bounded answer and bound sender required')
+        with self.store.transaction() as db:
+            task, policy = self._authorize(db, task_id, generation, require_running=executor)
+            if not policy.allow_reply or target != policy.reply_target:
+                raise ContractError('delivery target is not authorized')
+            effect_id = 'send_' + key(task['business_id'], 'answer')[:32]
+            old = db.execute('SELECT * FROM h1_effects WHERE effect_id=?', (effect_id,)).fetchone()
+            if old:
+                if (old['body'], old['target']) != (body, target):
+                    raise ContractError('same delivery identity different body or target')
+                return dict(old)  # including unknown: never resend blindly
+            db.execute("INSERT INTO h1_effects VALUES(?,?,?,?,?,'sending',NULL,?,NULL)",
+                       (effect_id,task_id,generation,body,target,self.store.clock()))
+        # Sender is the trusted host port and must not expose a credential to the Agent.
+        # Immediate recheck closes the ordinary queued/revoked case; upstream SDK must
+        # preserve this authorization point and stable effect ID in cross-process use.
+        denied = False
+        with self.store.transaction() as db:
+            try:
+                self._authorize(db, task_id, generation, require_running=executor)
+            except ContractError:
+                db.execute("UPDATE h1_effects SET state='denied' WHERE effect_id=?",(effect_id,))
+                denied = True
+        if denied:
+            raise ContractError('authorization changed before send')
+        try:
+            receipt = sender(target=target, body=body, idempotency_key=effect_id)
+            state = 'sent' if isinstance(receipt, dict) and receipt.get('platform_id') else 'unknown'
+        except Exception:
+            receipt, state = {}, 'unknown'
+        with self.store.transaction() as db:
+            db.execute('UPDATE h1_effects SET state=?,platform_id=?,platform_time=? WHERE effect_id=?',
+                       (state,receipt.get('platform_id'),receipt.get('platform_time'),effect_id))
+            db.execute('UPDATE h1_tasks SET delivery_state=? WHERE task_id=?',
+                       ('delivered' if state == 'sent' else 'unknown', task_id))
+            current = self.task(task_id,db)
+            if state=='sent' and current['execution_state'] in {'succeeded','failed','cancelled'}:
+                db.execute("UPDATE h1_sessions SET state='free',task_id=NULL WHERE task_id=? AND generation=?",(task_id,generation))
+            return dict(db.execute('SELECT * FROM h1_effects WHERE effect_id=?', (effect_id,)).fetchone())
+
+    def record_send_receipt(self, *, task_id, effect_id, platform_id):
+        """Trusted sender/receiver supplies the exact effect-to-message mapping.
+
+        This is not a content/thread search and cannot be called by a source
+        message. Independent platform readback still follows verify_delivery.
+        """
+        if not isinstance(platform_id,str) or not platform_id:
+            raise ContractError('platform message identity required')
+        with self.store.transaction() as db:
+            effect=db.execute('SELECT * FROM h1_effects WHERE effect_id=? AND task_id=?',(effect_id,task_id)).fetchone()
+            if not effect or effect['state'] not in {'sending','unknown','sent'}:
+                raise ContractError('no unresolved or sent effect')
+            if effect['platform_id'] and effect['platform_id']!=platform_id:
+                raise ContractError('conflicting platform message mapping')
+            db.execute("UPDATE h1_effects SET state='sent',platform_id=? WHERE effect_id=?",(platform_id,effect_id))
+            db.execute("UPDATE h1_tasks SET delivery_state='delivered' WHERE task_id=?",(task_id,))
+
+    def verify_delivery(self, task_id, evidence):
+        """Evidence comes from an independently bound host reader, never model text."""
+        with self.store.transaction() as db:
+            task = self.task(task_id, db)
+            effect = db.execute('SELECT * FROM h1_effects WHERE task_id=?', (task_id,)).fetchone()
+            if not effect or not effect['platform_id']:
+                raise ContractError('exact output mapping missing')
+            if any(evidence.get(k) != v for k,v in {
+                    'platform_id':effect['platform_id'], 'target':effect['target'],
+                    'body':effect['body'], 'sender_id':self.config.bot_id}.items()):
+                raise ContractError('output evidence mismatch; thread match is insufficient')
+            platform_time = evidence.get('platform_time')
+            if not isinstance(platform_time, (int,float)) or isinstance(platform_time, bool) or platform_time <= 0:
+                raise ContractError('verified platform generation time required')
+            stamps = json.loads(task['stamps'])
+            stamps.setdefault('t_p', platform_time)
+            stamps.setdefault('t_o', self.store.clock())
+            result = json.loads(task['result_json'] or '{}')
+            full = result.get('response_kind') == 'sufficient' and not result.get('remaining_requirements')
+            if full:
+                stamps.setdefault('full_completed_at', platform_time)
+            if task['verification_state'] != 'conflict':
+                db.execute("UPDATE h1_tasks SET verification_state='sufficient',stamps=? WHERE task_id=?", (dumps(stamps),task_id))
+            if task['execution_state'] in {'succeeded','failed','cancelled'}:
+                db.execute("UPDATE h1_sessions SET state='free',task_id=NULL WHERE task_id=? AND generation=?",
+                           (task_id,task['generation']))
+            return self.task(task_id, db)
diff --git a/am-grok-realtime/src/am_gateway/phase1/contracts.py b/am-grok-realtime/src/am_gateway/phase1/contracts.py
new file mode 100644
index 000000000..a31323274
--- /dev/null
+++ b/am-grok-realtime/src/am_gateway/phase1/contracts.py
@@ -0,0 +1,144 @@
+"""Trusted contracts. Source text and classifier output never supply authority."""
+from dataclasses import asdict, dataclass, field
+import math
+
+from ..models import ContractError, dumps, key
+
+INTENTS = ("project.query", "conversation.reply", "work_message.assist",
+           "document.process", "project.execute", "code.execute", "context.supplement")
+ANSWER_KINDS = {"sufficient", "partial", "clarification", "data_gap", "unavailable", "failed"}
+TERMINAL = {"succeeded", "failed", "cancelled"}
+
+
+@dataclass(frozen=True)
+class Capability:
+    name: str
+    adapter: str
+    execution_scope: str
+    available: bool = False
+    schema_version: str = "1.0"
+    reply_owner: str = "adapter"
+    durable_acceptance: bool = False
+    status_query: bool = False
+    cancellation: bool = False
+    isolation: bool = False
+    enforced_tools: bool = False
+    evidence_ref: str = ""
+
+
+def registry():
+    # Deliberately unavailable: a webhook 200 is NOT a durable receiver ACK.
+    result = {i: Capability(i, "grok_bot", "grok_bot:shared") for i in INTENTS[:3]}
+    result.update({i: Capability(i, i.split('.')[0] + "_agent", i) for i in INTENTS[3:6]})
+    result["context.supplement"] = Capability("context.supplement", "harness", "harness", True,
+                                              reply_owner="harness", enforced_tools=True)
+    return result
+
+
+@dataclass(frozen=True)
+class HarnessConfig:
+    tenant_id: str
+    bot_id: str
+    owner_id: str
+    owner_chat_id: str
+    route_version: str = "2026-11-06.2"
+    capabilities: dict = field(default_factory=registry)
+    queue_limit: int = 32
+    dispatch_deadline_seconds: float = 120.0
+    execution_deadline_seconds: float = 180.0
+    lease_seconds: float = 30.0
+    classification_budget_seconds: float = 6.0
+    dispatch_reserve_seconds: float = 1.0
+    delta_limit: int = 40
+    context_bytes: int = 16384
+
+    def validate(self):
+        if not all((self.tenant_id, self.bot_id, self.owner_id, self.owner_chat_id)):
+            raise ContractError("identity bindings required")
+        for value in (self.dispatch_deadline_seconds, self.execution_deadline_seconds,
+                      self.lease_seconds, self.classification_budget_seconds, self.dispatch_reserve_seconds):
+            if isinstance(value, bool) or not math.isfinite(value) or value <= 0:
+                raise ContractError("finite positive budgets required")
+        if not 1 <= self.queue_limit <= 1000 or not 1 <= self.delta_limit <= 1000 or not 1024 <= self.context_bytes <= 65536:
+            raise ContractError("invalid bounded queue/context configuration")
+        if set(self.capabilities) != set(INTENTS):
+            raise ContractError("registered intent set differs from schema")
+        for name, cap in self.capabilities.items():
+            if cap.name != name or cap.schema_version != "1.0":
+                raise ContractError("unsupported capability schema")
+            if cap.available and cap.adapter != "harness" and not (cap.durable_acceptance and cap.evidence_ref):
+                raise ContractError("available adapter needs durable acceptance evidence")
+
+
+@dataclass(frozen=True)
+class Policy:
+    """Produced by the host authorization port, never the model or incoming JSON."""
+    principal: str
+    authorization_ref: str
+    reply_target: str
+    source_chats: tuple[str, ...]
+    projects: tuple[str, ...] = ()
+    business_operations: tuple[str, ...] = ()
+    allow_reply: bool = False
+    allow_supplement: bool = False
+    version: int = 1
+    revoked: bool = False
+
+    def validate(self):
+        if not self.principal or not self.authorization_ref or not self.reply_target:
+            raise ContractError("policy identity and target required")
+        if self.version < 1 or not isinstance(self.source_chats, tuple) or not isinstance(self.projects, tuple):
+            raise ContractError("invalid policy")
+        # Phase one intentionally does not implement business writes.
+        if self.business_operations:
+            raise ContractError("business write capability is not connected")
+        dumps(asdict(self))
+
+    def json(self):
+        self.validate()
+        return dumps(asdict(self))
+
+    @classmethod
+    def parse(cls, value):
+        import json
+        data = json.loads(value) if isinstance(value, str) else dict(value)
+        for name in ("source_chats", "projects", "business_operations"):
+            data[name] = tuple(data.get(name, ()))
+        policy = cls(**data)
+        policy.validate()
+        return policy
+
+
+def business_fingerprint(*, text, intent, principal, reply_target, attachments, inputs):
+    """Frozen semantics; route version, attempt, epoch, evidence and policy version excluded."""
+    return key({"text": text, "intent": intent, "principal": principal,
+                "reply_target": reply_target, "attachments": attachments, "inputs": inputs})
+
+
+def validate_envelope(envelope):
+    if envelope.get('schema_version') != '1.0':
+        raise ContractError('unsupported envelope version')
+    policy = Policy.parse(envelope['policy'])
+    identity, execution = envelope['identity'], envelope['execution']
+    required = {'task_id','request_revision','business_operation_id','idempotency_key',
+                'dispatch_attempt_id','business_fingerprint'}
+    if set(identity) != required or identity['idempotency_key'] != identity['business_operation_id']:
+        raise ContractError('invalid operation identity')
+    if any(not isinstance(identity[n],str) or not identity[n] for n in required-{'request_revision'}):
+        raise ContractError('identity strings required')
+    for value in (identity['request_revision'],execution['generation']):
+        if not isinstance(value,int) or isinstance(value,bool) or value<1:
+            raise ContractError('positive revision and epoch required')
+    for name in ('accept_deadline','completion_deadline'):
+        value=execution[name]
+        if not isinstance(value,(int,float)) or isinstance(value,bool) or not math.isfinite(value) or value<=0:
+            raise ContractError('finite deadline required')
+    payload=envelope['payload']
+    if envelope['routing']['intent'] not in INTENTS or envelope['output']['reply_target']!=policy.reply_target:
+        raise ContractError('routing/target contract mismatch')
+    expected=business_fingerprint(text=payload['raw_text'],intent=envelope['routing']['intent'],
+        principal=policy.principal,reply_target=policy.reply_target,attachments=payload['attachment_refs'],
+        inputs=payload['structured_inputs'])
+    if expected!=identity['business_fingerprint']:
+        raise ContractError('business input fingerprint mismatch')
+    return envelope
diff --git a/am-grok-realtime/src/am_gateway/phase1/cutover.py b/am-grok-realtime/src/am_gateway/phase1/cutover.py
new file mode 100644
index 000000000..3fea02b7b
--- /dev/null
+++ b/am-grok-realtime/src/am_gateway/phase1/cutover.py
@@ -0,0 +1,65 @@
+"""Scope ownership is a persisted handover, never a time-based history skip."""
+import json
+
+from ..models import ContractError, dumps, key
+
+
+class Cutover:
+    def register_cutover(self, scope, *, evidence_ref):
+        if not evidence_ref:
+            raise ContractError('polling isolation or shared-claim evidence required')
+        with self.store.transaction() as db:
+            old = db.execute('SELECT state FROM h1_cutover WHERE scope=?', (scope,)).fetchone()
+            if old and old[0] != 'harness':
+                raise ContractError('existing handover must be reconciled')
+            db.execute("INSERT OR REPLACE INTO h1_cutover VALUES(?,'harness',?,NULL)", (scope,evidence_ref))
+
+    def prepare_rollback(self, scope):
+        with self.store.transaction() as db:
+            scope_row = db.execute('SELECT * FROM h1_cutover WHERE scope=?', (scope,)).fetchone()
+            if not scope_row:
+                raise ContractError('scope was not enabled')
+            rows = db.execute('SELECT * FROM h1_tasks WHERE scope=? ORDER BY created', (scope,)).fetchall()
+            manifest = {'scope':scope,'completed':[],'unresolved':[],'undispatched':[]}
+            for row in rows:
+                entry = {'task_id':row['task_id'],'item_id':row['item_id'],
+                         'business_id':row['business_id'],'state':row['execution_state']}
+                if row['delivery_state'] == 'delivered' and row['verification_state'] == 'sufficient' and row['execution_state'] in {'succeeded','failed','cancelled'}:
+                    manifest['completed'].append(entry)
+                elif row['business_id']:
+                    manifest['unresolved'].append(entry)
+                else:
+                    manifest['undispatched'].append(entry)
+            manifest['fingerprint'] = key(manifest)
+            db.execute("UPDATE h1_cutover SET state='paused',manifest=? WHERE scope=?", (dumps(manifest),scope))
+            return manifest
+
+    def acknowledge_legacy_import(self, scope, *, fingerprint, excluded_items, pending_owner):
+        with self.store.transaction() as db:
+            row = db.execute('SELECT * FROM h1_cutover WHERE scope=?', (scope,)).fetchone()
+            if not row or row['state'] != 'paused':
+                raise ContractError('scope must be paused')
+            manifest = json.loads(row['manifest'])
+            if fingerprint != manifest['fingerprint']:
+                raise ContractError('handover fingerprint mismatch')
+            # Refuse stale manifests if work was admitted after the pause.
+            actual = {r[0] for r in db.execute('SELECT task_id FROM h1_tasks WHERE scope=?', (scope,))}
+            expected = {r['task_id'] for group in ('completed','unresolved','undispatched') for r in manifest[group]}
+            if actual != expected:
+                raise ContractError('new backlog needs a refreshed manifest')
+            required = {r['item_id'] for group in ('completed','unresolved') for r in manifest[group]}
+            if not required <= set(excluded_items):
+                raise ContractError('legacy has not imported completed/uncertain exclusions')
+            if set(pending_owner) != {r['task_id'] for r in manifest['undispatched']} or any(v not in {'harness','legacy'} for v in pending_owner.values()):
+                raise ContractError('every undispatched task needs an explicit owner')
+            if db.execute("SELECT 1 FROM h1_sessions WHERE scope=? AND state!='free'", (scope,)).fetchone():
+                raise ContractError('running or uncertain executor still owns this scope')
+            # Unresolved business effects remain excluded and attached to their existing records.
+            for tid, owner in pending_owner.items():
+                if owner == 'legacy':
+                    db.execute("UPDATE h1_dispatch SET state='legacy_owned' WHERE task_id=?", (tid,))
+                    db.execute("UPDATE h1_tasks SET dispatch_state='legacy_owned' WHERE task_id=?", (tid,))
+            manifest['legacy_exclusions'] = sorted(excluded_items)
+            manifest['pending_owner'] = pending_owner
+            db.execute("UPDATE h1_cutover SET state='legacy',manifest=? WHERE scope=?", (dumps(manifest),scope))
+            return manifest
diff --git a/am-grok-realtime/src/am_gateway/phase1/information.py b/am-grok-realtime/src/am_gateway/phase1/information.py
new file mode 100644
index 000000000..13233394c
--- /dev/null
+++ b/am-grok-realtime/src/am_gateway/phase1/information.py
@@ -0,0 +1,205 @@
+"""Extractive shared information in the gateway database, with source ACL inheritance."""
+import json
+
+from ..models import ContractError, dumps, key
+from .contracts import Policy
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS h1_info(
+ seq INTEGER PRIMARY KEY AUTOINCREMENT, info_id TEXT UNIQUE NOT NULL,
+ project TEXT NOT NULL, nature TEXT NOT NULL, body TEXT NOT NULL,
+ sources TEXT NOT NULL, readers TEXT NOT NULL, audiences TEXT NOT NULL,
+ derives TEXT NOT NULL, state TEXT NOT NULL, created REAL NOT NULL
+);
+CREATE INDEX IF NOT EXISTS h1_info_project ON h1_info(project,seq);
+CREATE TABLE IF NOT EXISTS h1_views(
+ project TEXT PRIMARY KEY, watermark INTEGER NOT NULL, info_ids TEXT NOT NULL
+);
+CREATE TABLE IF NOT EXISTS h1_sync(
+ source TEXT PRIMARY KEY, cursor TEXT, state TEXT NOT NULL, detail TEXT NOT NULL,
+ coverage TEXT NOT NULL, updated REAL NOT NULL
+);
+CREATE TABLE IF NOT EXISTS h1_projection(item_id TEXT PRIMARY KEY, version INTEGER NOT NULL);
+"""
+NATURES = {"feedback", "forecast", "formal_record", "decision", "pending_requirement",
+           "execution_claim", "verified_result"}
+
+
+class Information:
+    def __init__(self, store, config):
+        self.store, self.config = store, config
+        with store.transaction() as db:
+            for statement in SCHEMA.split(';'):
+                if statement.strip():
+                    db.execute(statement)
+
+    def project_sources(self, limit=100):
+        """Background extractive projection, never on the query's critical path.
+
+        ACL comes from the trusted admission policy. Unknown project association
+        stays in source storage; no model guesses the owning project.
+        """
+        if not 1 <= limit <= 1000:
+            raise ContractError('bounded projection required')
+        count = 0
+        with self.store.transaction() as db:
+            rows = db.execute("""SELECT i.*,b.policy_json FROM gw_items i JOIN h1_inbox b USING(item_id)
+                LEFT JOIN h1_projection p USING(item_id) WHERE p.version IS NULL OR p.version<i.version
+                ORDER BY i.received_at LIMIT ?""",(limit,)).fetchall()
+            for row in rows:
+                event = json.loads(row['event_json'])
+                if row['policy_json'] != '{}' and not row['is_deleted'] and not row['is_self']:
+                    policy = Policy.parse(row['policy_json'])
+                    if not policy.revoked and row['chat_id'] in policy.source_chats:
+                        for project in event['project_ids']:
+                            if project not in policy.projects:
+                                continue
+                            # Explicit supplements have already been committed synchronously.
+                            supplement = db.execute("SELECT source_version FROM h1_tasks WHERE item_id=? AND intent='context.supplement' AND execution_state='succeeded'",(row['item_id'],)).fetchone()
+                            if not supplement or supplement['source_version']!=row['version']:
+                                self.append(project=project,nature='pending_requirement' if supplement else 'feedback',body=event['body'],
+                                    sources=[{'item_id':row['item_id'],'version':row['version']}],
+                                    readers=[policy.principal],audiences=[policy.reply_target],
+                                    operation_id=key('extractive',row['item_id'],row['version'],project),db=db)
+                                count += 1
+                db.execute('INSERT OR REPLACE INTO h1_projection VALUES(?,?)',(row['item_id'],row['version']))
+        return count
+
+    def append(self, *, project, nature, body, sources, readers, audiences,
+               operation_id, derives=(), db=None, verified_evidence=False):
+        if nature not in NATURES or not project or not body or not sources or not readers or not audiences:
+            raise ContractError("information needs project, nature, evidence and ACL")
+        if nature == "verified_result" and not verified_evidence:
+            raise ContractError("agent claims are not verified results")
+        if len(body.encode()) > 65536:
+            raise ContractError("information too large")
+        if db is None:
+            with self.store.transaction() as con:
+                return self.append(project=project, nature=nature, body=body, sources=sources,
+                                   readers=readers, audiences=audiences, operation_id=operation_id,
+                                   derives=derives, db=con, verified_evidence=verified_evidence)
+        readers, audiences = set(readers), set(audiences)
+        refs = {dumps(r): r for r in sources}
+        for parent_id in derives:
+            parent = db.execute("SELECT * FROM h1_info WHERE info_id=?", (parent_id,)).fetchone()
+            if not parent or parent['state'] != 'active':
+                raise ContractError("derived source unavailable")
+            readers &= set(json.loads(parent['readers']))
+            audiences &= set(json.loads(parent['audiences']))
+            refs.update({dumps(r): r for r in json.loads(parent['sources'])})
+        if not readers or not audiences:
+            raise ContractError("empty inherited ACL")
+        for ref in refs.values():
+            row = db.execute("SELECT version,is_deleted FROM gw_items WHERE item_id=?", (ref['item_id'],)).fetchone()
+            if not row or row['is_deleted'] or row['version'] != ref['version']:
+                raise ContractError("source revision unavailable")
+        ident = 'info_' + key(operation_id)[:32]
+        values = (project, nature, body, dumps(list(refs.values())), dumps(sorted(readers)),
+                  dumps(sorted(audiences)), dumps(list(derives)))
+        old = db.execute("SELECT * FROM h1_info WHERE info_id=?", (ident,)).fetchone()
+        if old:
+            if tuple(old[n] for n in ('project','nature','body','sources','readers','audiences','derives')) != values:
+                raise ContractError("information operation payload conflict")
+            return dict(old)
+        db.execute("""INSERT INTO h1_info(info_id,project,nature,body,sources,readers,audiences,
+                    derives,state,created) VALUES(?,?,?,?,?,?,?,?,?,?)""",
+                   (ident, *values, 'active', self.store.clock()))
+        return dict(db.execute("SELECT * FROM h1_info WHERE info_id=?", (ident,)).fetchone())
+
+    def invalidate(self, item_id, db):
+        # Sources are inherited transitively, including after a parent is withdrawn.
+        for row in db.execute("SELECT info_id,sources FROM h1_info WHERE state='active'"):
+            if any(r['item_id'] == item_id for r in json.loads(row['sources'])):
+                db.execute("UPDATE h1_info SET state='stale' WHERE info_id=?", (row['info_id'],))
+
+    def revoke(self, info_id):
+        with self.store.transaction() as db:
+            pending = [info_id]
+            while pending:
+                current = pending.pop()
+                db.execute("UPDATE h1_info SET state='revoked' WHERE info_id=?", (current,))
+                for row in db.execute("SELECT info_id,derives FROM h1_info WHERE state='active'"):
+                    if current in json.loads(row['derives']):
+                        pending.append(row['info_id'])
+
+    def project_view(self, project):
+        with self.store.transaction() as db:
+            watermark = db.execute("SELECT coalesce(max(seq),0) FROM h1_info").fetchone()[0]
+            rows = db.execute("SELECT info_id FROM h1_info WHERE project=? AND state='active' ORDER BY seq DESC LIMIT ?",
+                              (project, self.config.delta_limit)).fetchall()
+            db.execute("INSERT OR REPLACE INTO h1_views VALUES(?,?,?)", (project, watermark, dumps([r[0] for r in rows])))
+            return watermark
+
+    @staticmethod
+    def allowed(db, row, policy):
+        if row['state'] != 'active' or row['project'] not in policy.projects:
+            return False
+        if policy.principal not in json.loads(row['readers']) or policy.reply_target not in json.loads(row['audiences']):
+            return False
+        for ref in json.loads(row['sources']):
+            source = db.execute("SELECT version,is_deleted,chat_id FROM gw_items WHERE item_id=?", (ref['item_id'],)).fetchone()
+            if not source or source['is_deleted'] or source['version'] != ref['version'] or source['chat_id'] not in policy.source_chats:
+                return False
+        return True
+
+    def snapshot(self, policy, *, minimum_visible_version=0, db=None):
+        if db is None:
+            with self.store.transaction() as con:
+                return self.snapshot(policy, minimum_visible_version=minimum_visible_version, db=con)
+        if policy.revoked:
+            raise ContractError("authorization revoked")
+        committed = db.execute("SELECT coalesce(max(seq),0) FROM h1_info").fetchone()[0]
+        if committed < minimum_visible_version:
+            raise ContractError("minimum visible version unavailable")
+        candidates, watermarks, lag = {}, {}, False
+        for project in policy.projects:
+            view = db.execute("SELECT * FROM h1_views WHERE project=?", (project,)).fetchone()
+            watermarks[project] = view['watermark'] if view else 0
+            for info_id in json.loads(view['info_ids']) if view else []:
+                row = db.execute("SELECT * FROM h1_info WHERE info_id=?", (info_id,)).fetchone()
+                if row:
+                    candidates[row['info_id']] = row
+            delta = db.execute("SELECT * FROM h1_info WHERE project=? AND seq>? ORDER BY seq DESC LIMIT ?",
+                               (project, watermarks[project], self.config.delta_limit + 1)).fetchall()
+            lag |= len(delta) > self.config.delta_limit
+            for row in delta[:self.config.delta_limit]:
+                candidates[row['info_id']] = row
+        items = []
+        # Check ACL before the size accounting, so restricted rows never become references.
+        for row in sorted(candidates.values(), key=lambda r: r['seq'], reverse=True):
+            if not self.allowed(db, row, policy):
+                continue
+            value = {n: row[n] for n in ('info_id','seq','project','nature','body')}
+            value['sources'] = json.loads(row['sources'])
+            # Reserve bounded metadata overhead; never include an oversize latest item silently.
+            if len(dumps(items + [value]).encode()) > self.config.context_bytes - 1024:
+                lag = True
+                continue
+            items.append(value)
+        coverage = [dict(r) for r in db.execute("SELECT * FROM h1_sync ORDER BY source")
+                    if r['source'] in policy.source_chats]
+        snapshot = {"snapshot_version": committed, "minimum_visible_version": minimum_visible_version,
+                    "policy_version": policy.version, "source_watermarks": watermarks,
+                    "evidence_items": items, "view_lag_warning": bool(lag),
+                    "coverage": coverage[:8], "coverage_complete": False,
+                    "read_more": "task-scoped information lookup; older relevant items may be omitted"}
+        # Coverage detail is diagnostic, not an unbounded payload backdoor.
+        while len(dumps(snapshot).encode()) > self.config.context_bytes and snapshot['coverage']:
+            snapshot['coverage'].pop()
+            snapshot['view_lag_warning'] = True
+        if len(dumps(snapshot).encode()) > self.config.context_bytes:
+            raise ContractError("context metadata exceeds budget")
+        return snapshot
+
+    def read(self, policy, info_id):
+        with self.store.transaction() as db:
+            row = db.execute("SELECT * FROM h1_info WHERE info_id=?", (info_id,)).fetchone()
+            if policy.revoked or not row or not self.allowed(db, row, policy):
+                raise ContractError("information outside current task scope")
+            return {n: row[n] for n in ('info_id', 'project', 'nature', 'body')}
+
+    def sync_failure(self, source, error_type):
+        with self.store.transaction() as db:
+            db.execute("""INSERT INTO h1_sync VALUES(?,NULL,'failed',?,'{}',?)
+                ON CONFLICT(source) DO UPDATE SET state='failed',detail=excluded.detail,updated=excluded.updated""",
+                       (source, error_type[:120], self.store.clock()))
diff --git a/am-grok-realtime/src/am_gateway/phase1/lifecycle.py b/am-grok-realtime/src/am_gateway/phase1/lifecycle.py
new file mode 100644
index 000000000..b9382b2ba
--- /dev/null
+++ b/am-grok-realtime/src/am_gateway/phase1/lifecycle.py
@@ -0,0 +1,125 @@
+"""Trusted receiver evidence; duplicate/late events cannot regress terminal states."""
+import json
+import math
+
+from ..models import ContractError, dumps
+from .contracts import ANSWER_KINDS, TERMINAL
+
+
+class Lifecycle:
+    def record_receipt(self, *, event_id, task_id, business_id, generation, kind, payload):
+        if kind not in {'accepted', 'running', 'ended', 'result', 'unknown'} or not event_id or not isinstance(payload, dict):
+            raise ContractError('invalid receipt')
+        encoded = dumps(payload)
+        with self.store.transaction() as db:
+            task = self.task(task_id, db)
+            if task['business_id'] != business_id:
+                raise ContractError('receipt operation mismatch')
+            old = db.execute('SELECT * FROM h1_receipts WHERE event_id=?', (event_id,)).fetchone()
+            if old:
+                if (old['task_id'],old['generation'],old['kind'],old['payload']) != (task_id,generation,kind,encoded):
+                    raise ContractError('receipt identity payload conflict')
+                return task
+            db.execute('INSERT INTO h1_receipts VALUES(?,?,?,?,?,?)',
+                       (event_id,task_id,generation,kind,encoded,self.store.clock()))
+            if generation != task['generation']:
+                self.store.audit(db, 'stale_receipt', task_id, str(generation))
+                return task
+            stamps = json.loads(task['stamps'])
+            terminal = task['execution_state'] in TERMINAL
+            if kind == 'accepted':
+                if not payload.get('durable_record') or not payload.get('run_id'):
+                    raise ContractError('webhook acceptance is not durable task acceptance')
+                if task['run_id'] and payload['run_id'] != task['run_id']:
+                    raise ContractError('conflicting execution instance')
+                stamps.setdefault('t_a', self.store.clock())
+                stamps.setdefault('accepted_at', payload.get('accepted_at'))
+                db.execute("UPDATE h1_tasks SET dispatch_state='accepted',run_id=? WHERE task_id=?", (payload['run_id'],task_id))
+                db.execute("UPDATE h1_dispatch SET state='accepted' WHERE task_id=?", (task_id,))
+            elif kind == 'running':
+                if not payload.get('run_id') or (task['run_id'] and task['run_id'] != payload['run_id']):
+                    raise ContractError('execution instance required')
+                if not terminal:
+                    db.execute("UPDATE h1_tasks SET execution_state='running',run_id=? WHERE task_id=?", (payload['run_id'],task_id))
+                    stamps.setdefault('execution_started_observed', self.store.clock())
+                    stamps.setdefault('execution_started_at', payload.get('started_at'))
+            elif kind == 'unknown':
+                if not terminal:
+                    db.execute("UPDATE h1_tasks SET execution_state='unknown' WHERE task_id=?", (task_id,))
+            elif kind == 'ended':
+                state = payload.get('status')
+                if state not in TERMINAL or not payload.get('stopped_evidence') or not payload.get('run_id'):
+                    raise ContractError('end requires correlated evidence that protected execution stopped')
+                if task['run_id'] and task['run_id'] != payload['run_id']:
+                    raise ContractError('end instance mismatch')
+                if terminal and task['execution_state'] != state:
+                    db.execute("UPDATE h1_tasks SET verification_state='conflict',last_error='contradictory_terminal_evidence' WHERE task_id=?", (task_id,))
+                else:
+                    db.execute('UPDATE h1_tasks SET execution_state=?,run_id=?,lease_until=NULL WHERE task_id=?', (state,payload['run_id'],task_id))
+                    stamps.setdefault('execution_ended_observed', self.store.clock())
+                    if not db.execute("SELECT 1 FROM h1_effects WHERE task_id=? AND state IN ('sending','unknown')",(task_id,)).fetchone():
+                        db.execute("UPDATE h1_sessions SET task_id=NULL,state='free' WHERE scope=? AND task_id=? AND generation=?",
+                                   (task['scope'],task_id,generation))
+            elif kind == 'result':
+                if payload.get('response_kind') not in ANSWER_KINDS:
+                    raise ContractError('result kind required')
+                if not isinstance(payload.get('remaining_requirements'), list) or not isinstance(payload.get('artifacts'), list):
+                    raise ContractError('result must declare requirements and artifacts')
+                if not payload.get('run_id') or (task['run_id'] and payload['run_id'] != task['run_id']):
+                    raise ContractError('result instance mismatch')
+                if task['result_json'] and task['result_json'] != encoded:
+                    db.execute("UPDATE h1_tasks SET verification_state='conflict',last_error='conflicting_result' WHERE task_id=?", (task_id,))
+                else:
+                    db.execute('UPDATE h1_tasks SET result_json=? WHERE task_id=?', (encoded,task_id))
+                    stamps.setdefault('result_observed', self.store.clock())
+            db.execute('UPDATE h1_tasks SET stamps=? WHERE task_id=?', (dumps(stamps),task_id))
+            return self.task(task_id, db)
+
+    def dispatch_one(self):
+        # No trigger can be invoked without an explicit cutover ledger entry.
+        enabled = self.store.rows("SELECT scope FROM h1_cutover WHERE state='harness'")
+        if not enabled:
+            return None
+        envelope = self.claim(require_cutover=True)
+        if envelope is None:
+            return None
+        task_id = envelope['identity']['task_id']
+        scope = envelope['execution']['scope']
+        if scope not in {r['scope'] for r in enabled}:
+            raise ContractError('scope cutover not verified')
+        adapter = self.adapters.get(envelope['routing']['adapter'])
+        try:
+            if adapter is None:
+                raise ContractError('adapter unbound')
+            receipt = adapter.accept(envelope)
+            if not isinstance(receipt, dict) or receipt.get('kind') != 'accepted':
+                raise ContractError('receiver has not durably accepted')
+            self.record_receipt(event_id=receipt['event_id'], task_id=task_id,
+                business_id=envelope['identity']['business_operation_id'],
+                generation=envelope['execution']['generation'], kind='accepted', payload=receipt['payload'])
+        except Exception as exc:
+            with self.store.transaction() as db:
+                # Callback may have reached us before accept() returned. Do not undo it.
+                current = self.task(task_id, db)
+                if current['dispatch_state'] != 'accepted':
+                    db.execute("UPDATE h1_tasks SET dispatch_state='unknown',execution_state='unknown',last_error=? WHERE task_id=?",
+                               (type(exc).__name__,task_id))
+                    db.execute("UPDATE h1_dispatch SET state='unknown' WHERE task_id=?", (task_id,))
+        return self.task(task_id)
+
+    def query_execution(self, task_id):
+        task = self.task(task_id)
+        cap = self.config.capabilities[task['intent']]
+        adapter = self.adapters.get(cap.adapter)
+        if not cap.status_query or adapter is None:
+            return {'status':'unknown','reason':'status_interface_unavailable'}
+        # Receiver status lookup must use stable operation identity, not a new dispatch.
+        return adapter.query(task['business_id'], task['run_id'], task['generation'])
+
+    def request_cancel(self, task_id):
+        task = self.task(task_id)
+        cap = self.config.capabilities[task['intent']]
+        adapter = self.adapters.get(cap.adapter)
+        if not cap.cancellation or adapter is None:
+            return {'status':'unsupported','stopped':False}
+        return adapter.cancel(task['business_id'], task['run_id'], task['generation'])
