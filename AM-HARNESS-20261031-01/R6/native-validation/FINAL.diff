+"""Natural followup uses existing state; language never grants send authority."""
+import json
+from types import SimpleNamespace as NS
+import pytest
+
+from test_followup_native import native, service, am_rig, base_rig
+from test_followup_text_host import incoming
+from test_gateway import drain
+from am_conversation.followup_tools import NativeFollowupTools
+from am_conversation.tools import ToolRegistry
+from am_conversation.types import AccessContext, ConversationError
+
+
+def tools(n):
+    row=dict(n.row,kind='conversation',body='他回复了吗？')
+    ctx=AccessContext(n.row['tenant'],n.row['app'],n.row['user'],n.row['chat'],
+        allowed_project_ids=frozenset([n.item['project_ref']]),is_owner=True,content_expires_at=n.row['expires'])
+    b=NS(service=n.am,s=n.s,registry=ToolRegistry(),authorize=lambda *a:None,_current=lambda c:{'row':row})
+    t=NativeFollowupTools(b);t.register()
+    return t,b,ctx,row
+
+
+def test_conversation_tools_cannot_approve_or_send(native):
+    n=native;t,b,ctx,row=tools(n)
+    assert set(b.registry._tools)=={'read_followup_status','read_followup_feedback','prepare_followup_message'}
+    result=t.status(ctx,{'item_id':n.item['id']},row['id'])
+    assert result['delivery_verified'] is False and not n.calls
+    assert t.current(row['id'])
+    n.am.items.change(n.am.owner,'pause-after-reading',n.item['id'],n.item['version'],'pause')
+    assert t.current(row['id']) is False
+
+
+def test_natural_quoted_confirmation_uses_single_original_send(native):
+    n=native;nonce=n.f.preview_text(n.row,n.item['id'],'recipient_p2p');drain(n.g)
+    card=n.s.rows('SELECT * FROM am_cards WHERE nonce=?',(nonce,))[0]
+    out=n.s.rows('SELECT * FROM outbox WHERE id=?',(card['outbox_id'],))[0]
+    assert '确认发送 ' not in out['body'] and '按这个发' in out['body']
+    row=incoming(n,'可以，发给他吧',2201,parent=card['message_id'],thread='natural-quote-thread')
+    n.am.step(row);n.am.scheduler.dispatch();n.am.scheduler.dispatch()
+    assert len(n.calls)==1
+    assert n.s.rows('SELECT state,readback_state FROM reminder_occurrences')==[{'state':'sent','readback_state':'verified'}]
+    t,b,ctx,question=tools(n)
+    assert t.status(ctx,{'item_id':n.item['id']},question['id'])['delivery']['state']=='verified'
+
+
+def test_unquoted_natural_confirmation_cannot_approve(native):
+    n=native;n.f.preview_text(n.row,n.item['id']);drain(n.g)
+    n.am.step(incoming(n,'按这个发',2202))
+    assert not n.s.rows('SELECT * FROM followup_intents') and not n.calls
+
+
+def test_ambiguous_pronoun_does_not_pick_an_item(native):
+    n=native;t,b,ctx,row=tools(n)
+    with pytest.raises(ConversationError,match='REFERENCE_AMBIGUOUS'):t.status(ctx,{},row['id'])
+    n.f.text_ui._remember(row,[n.item['id']])
+    assert t.status(ctx,{},row['id'])['description']==n.item['description']
+
+
+def test_new_feedback_invalidates_pending_natural_answer(native):
+    n=native;t,b,ctx,row=tools(n)
+    t.status(ctx,{'item_id':n.item['id']},row['id'])
+    n.s.execute('INSERT INTO followup_reply_links VALUES(?,?,?,?,?,?)',
+        ('later-reply',n.item['id'],'future-occurrence','ou_engineer_a','reported_update',n.clock()))
+    assert not t.current(row['id'])
+
+
+def test_original_conversation_registers_native_followup_tools(native):
+    from am_conversation.legacy import LegacyConversationBridge
+    n=native
+    b=LegacyConversationBridge(n.am,{'enabled':True})
+    try:
+        row=dict(n.row,kind='conversation',body='最近哪些事情需要我跟进？')
+        with b.request_context(row) as ctx:
+            result=b._followups(ctx,{},row['id'])
+            assert n.item['id'] in [x['id'] for x in result['items']]
+            assert b.native_followup_tools.current(row['id'])
+            assert 'prepare_followup_message' in b.registry._tools
+    finally:b.close()
diff --git a/am-integrated-r6/tests/resource_window/test_host.py b/am-integrated-r6/tests/resource_window/test_host.py
new file mode 100644
index 00000000..a40bd81b
--- /dev/null
+++ b/am-integrated-r6/tests/resource_window/test_host.py
@@ -0,0 +1,104 @@
+from contextlib import contextmanager
+import sqlite3
+import threading
+from types import SimpleNamespace
+import unittest
+import uuid
+
+from am_training_window.host import ExistingCoordinatorHost, StoreMaintenanceFence
+from am_training_window.window import HostBinding, HostObservation, ModelIdentity, WindowError
+
+MODEL = ModelIdentity("qwen3.8:27b-bartowski-q8_0", "a" * 64)
+BINDING = HostBinding("unique-consumer-1", "b" * 64, MODEL, "llamacpp")
+
+
+class StoreFixture:
+    def __init__(self):
+        self.db = sqlite3.connect(":memory:", isolation_level=None)
+        self.db.execute("CREATE TABLE meta(key TEXT PRIMARY KEY,value TEXT NOT NULL)")
+
+    @contextmanager
+    def tx(self):
+        self.db.execute("BEGIN IMMEDIATE")
+        try:
+            yield self.db
+            self.db.execute("COMMIT")
+        except BaseException:
+            self.db.execute("ROLLBACK")
+            raise
+
+    def rows(self, sql, args=()):
+        cursor = self.db.execute(sql, args)
+        names = [column[0] for column in cursor.description]
+        return [dict(zip(names, values)) for values in cursor.fetchall()]
+
+
+class HostAdapterTests(unittest.TestCase):
+    def setUp(self):
+        self.store = StoreFixture()
+        self.addCleanup(self.store.db.close)
+        self.fence = StoreMaintenanceFence(self.store)
+        self.owner = str(uuid.uuid4())
+
+    def test_owned_pause_claim_release_and_duplicate_claim(self):
+        self.fence.claim(self.owner)
+        self.fence.claim(self.owner)
+        self.assertEqual(self.fence.inspect(), self.owner)
+        self.assertIsNone(self.store.db.execute("SELECT value FROM meta WHERE key='provider_pause'").fetchone())
+        self.fence.seal(self.owner)
+        self.assertTrue(self.store.db.execute("SELECT value FROM meta WHERE key='provider_pause'").fetchone()[0])
+        self.fence.release(self.owner)
+        self.assertIsNone(self.fence.inspect())
+
+    def test_foreign_window_cannot_clear_pause(self):
+        self.fence.claim(self.owner)
+        foreign = str(uuid.uuid4())
+        with self.assertRaises(WindowError):
+            self.fence.claim(foreign)
+        with self.assertRaises(WindowError):
+            self.fence.release(foreign)
+        self.assertEqual(self.fence.inspect(), self.owner)
+
+    def test_unknown_stop_error_is_preserved(self):
+        self.fence.claim(self.owner)
+        self.fence.seal(self.owner)
+        self.store.db.execute("UPDATE meta SET value='STOP_UNKNOWN' WHERE key='provider_pause'")
+        with self.assertRaises(WindowError):
+            self.fence.release(self.owner)
+        with self.assertRaises(WindowError):
+            self.fence.inspect()
+        self.assertEqual(self.store.db.execute("SELECT value FROM meta WHERE key='provider_pause'").fetchone()[0], "STOP_UNKNOWN")
+
+    def test_preexisting_pause_never_overwritten(self):
+        self.store.db.execute("INSERT INTO meta VALUES('provider_pause','LOCAL_API_UNAVAILABLE')")
+        with self.assertRaises(WindowError):
+            self.fence.claim(self.owner)
+        self.assertEqual(self.store.db.execute("SELECT count(*) FROM meta").fetchone()[0], 1)
+
+    def test_unsealed_draining_can_release_without_pausing_provider(self):
+        self.fence.claim(self.owner)
+        self.fence.release(self.owner)
+        self.assertEqual(self.store.db.execute("SELECT count(*) FROM meta").fetchone()[0], 0)
+
+    def test_existing_lock_and_store_are_used_for_drain(self):
+        lock = threading.Lock()
+        coordinator = SimpleNamespace(store=self.store, lock=lock, complete=lambda: None)
+        observed = HostObservation(BINDING, 1, True, True, 0, 0, (MODEL,), None)
+        lifecycle = SimpleNamespace(suspend=lambda binding: None, restore=lambda binding: None)
+        adapter = ExistingCoordinatorHost(coordinator=coordinator, store=self.store,
+            read_observation=lambda: observed, lifecycle=lifecycle, drain_timeout_seconds=0)
+        adapter.close_admission(self.owner)
+        lock.acquire()
+        try:
+            with self.assertRaises(WindowError):
+                adapter.drain(self.owner)
+        finally:
+            lock.release()
+        adapter.drain(self.owner)
+        self.assertEqual(adapter.inspect().fence_owner, self.owner)
+        adapter.open_admission(self.owner)
+        self.assertIsNone(adapter.inspect().fence_owner)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/am-integrated-r6/tests/resource_window/test_mac_probe.py b/am-integrated-r6/tests/resource_window/test_mac_probe.py
new file mode 100644
index 00000000..5138dcc3
--- /dev/null
+++ b/am-integrated-r6/tests/resource_window/test_mac_probe.py
@@ -0,0 +1,99 @@
+from copy import deepcopy
+from datetime import datetime, timedelta, timezone
+import unittest
+
+from am_training_window.mac_probe import (
+    COMMANDS, ProbeError, collect_snapshot, compare_snapshots, parse_pages,
+    parse_processes, parse_swap, run_readonly,
+)
+
+
+VM = '''Mach Virtual Memory Statistics: (page size of 16384 bytes)
+Pages free: 100.
+Pages inactive: 200.
+Pages speculative: 30.
+Pages active: 2000.
+Pages wired down: 400.
+Pages occupied by compressor: 50.
+Pages stored in compressor: 100.
+Swapouts: 20.
+'''
+
+
+def fake_runner(argv):
+    values = {
+        "physical": str(64 * 1024**3),
+        "swap": "total = 2048.00M used = 650.00M free = 1398.00M (encrypted)",
+        "pressure": "1", "boot": "{ sec = 1234, usec = 0 } date",
+        "pages": VM,
+        "processes": "42 1 501 29000000 /private/user/path/llama-server\n43 1 501 100 /Applications/Some App Helper\n",
+    }
+    return values[next(k for k, value in COMMANDS.items() if value == tuple(argv))]
+
+
+class MacProbeTests(unittest.TestCase):
+    def snapshot(self, seconds=0):
+        return collect_snapshot(fake_runner, system="Darwin", captured_at=datetime(2026, 11, 3, tzinfo=timezone.utc) + timedelta(seconds=seconds))
+
+    def test_page_size_and_compressor_distinction(self):
+        parsed = parse_pages(VM)
+        self.assertEqual(parsed["diagnostic_free_inactive_speculative_bytes"], 330 * 16384)
+        self.assertEqual(parsed["compressor_physical_bytes"], 50 * 16384)
+        self.assertEqual(parsed["compressor_logical_bytes"], 100 * 16384)
+        self.assertEqual(parsed["swapouts_pages_since_boot"], 20)
+
+    def test_missing_counter_is_not_zero(self):
+        with self.assertRaises(ProbeError):
+            parse_pages(VM.replace("Pages inactive: 200.\n", ""))
+
+    def test_units_and_rss_are_not_bytes(self):
+        self.assertEqual(parse_swap("total = 2G used = 512M free = 1.5G")["used_bytes"], 512 * 1024**2)
+        self.assertEqual(parse_processes("1 0 0 8 /usr/bin/a")[0]["rss_bytes"], 8192)
+
+    def test_no_process_paths_or_arguments_in_output(self):
+        result = self.snapshot()
+        self.assertEqual(result["provider_candidates"][0]["executable"], "llama-server")
+        self.assertNotIn("/private/user", str(result))
+        self.assertFalse(result["model_identity_verified"])
+        self.assertEqual(result["resource_gate_status"], "not_checked")
+
+    def test_probe_failure_remains_unknown(self):
+        def bad(argv):
+            if tuple(argv) == COMMANDS["pressure"]:
+                raise RuntimeError("secret local exception")
+            return fake_runner(argv)
+        report = collect_snapshot(bad, system="Darwin")
+        self.assertEqual(report["status"], "partial")
+        self.assertIsNone(report["pressure_level"])
+        self.assertNotIn("secret local", str(report))
+
+    def test_linux_never_reads_mac_commands(self):
+        calls = []
+        result = collect_snapshot(lambda argv: calls.append(argv), system="Linux")
+        self.assertEqual(result["status"], "unsupported_platform")
+        self.assertEqual(calls, [])
+
+    def test_mutation_command_rejected_before_subprocess(self):
+        for argv in [("/usr/bin/killall", "llama-server"), ("/usr/sbin/purge",), ("/usr/sbin/sysctl", "-w", "a=1")]:
+            with self.subTest(argv=argv), self.assertRaises(ProbeError):
+                run_readonly(argv)
+
+    def test_delta_does_not_claim_attribution_or_admission(self):
+        b, a = self.snapshot(), self.snapshot(60)
+        a["memory"]["diagnostic_free_inactive_speculative_bytes"] += 20 * 1024**3
+        a["provider_candidates"] = []
+        delta = compare_snapshots(b, a)
+        self.assertEqual(delta["diagnostic_page_estimate_change_bytes"], 20 * 1024**3)
+        self.assertEqual(delta["causal_attribution"], "not_established")
+        self.assertEqual(delta["resource_gate_status"], "not_checked")
+
+    def test_delta_rejects_boot_time_or_partial_changes(self):
+        for mutate in [lambda a: a.update(boot_identity_sha256="different"), lambda a: a.update(status="partial"), lambda a: a.update(captured_at="2026-01-01T00:00:00+00:00")]:
+            b, a = self.snapshot(), self.snapshot(60)
+            mutate(a)
+            with self.subTest(a=a), self.assertRaises(ProbeError):
+                compare_snapshots(b, a)
+
+
+if __name__ == "__main__":
+    unittest.main()
