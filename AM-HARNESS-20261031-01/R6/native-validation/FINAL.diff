@@ -0,0 +1,157 @@
+"""Adapter to the actual AM ModelCoordinator + Store provider_pause boundary.
+
+Read from the current host: ModelCoordinator.complete takes its original
+thread/file locks and tests store.meta('provider_pause') before inference.
+This adapter adds an owned, persistent pause via the same Store transaction;
+it does not replace the coordinator or create another consumer.
+
+The llama.cpp manager itself is not in the supplied source snapshot, so its
+two exact lifecycle operations must be supplied from the original manager.
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+import math
+from typing import Callable, Protocol
+import uuid
+
+from .window import HostBinding, HostObservation, WindowError
+
+
+OWNER_KEY = "resource_window_owner"
+PAUSE_KEY = "provider_pause"
+PREFIX = "AM_RESOURCE_WINDOW:"
+
+
+def _owner(value: str) -> str:
+    parsed = str(uuid.UUID(value))
+    if parsed != value:
+        raise WindowError("window_owner_not_canonical")
+    return parsed
+
+
+def _get(connection, key):
+    row = connection.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
+    return row[0] if row else None
+
+
+class StoreMaintenanceFence:
+    """Two-phase CAS: stop new claims, drain, then seal the inference pause.
+
+    Setting provider_pause before active tasks finish can turn their later
+    model calls into failed/unknown tasks. The claim guards in host_overlay
+    are mandatory: owner-only draining must block new jobs before seal().
+    """
+    def __init__(self, store):
+        if not callable(getattr(store, "tx", None)) or not callable(getattr(store, "rows", None)):
+            raise TypeError("original Store.tx and Store.rows are required")
+        self.store = store
+
+    def inspect(self) -> str | None:
+        # One SELECT observes a consistent SQLite statement snapshot without
+        # starting an unnecessary write transaction or running write guards.
+        values = {row["key"]: row["value"] for row in self.store.rows(
+            "SELECT key,value FROM meta WHERE key IN (?,?)", (OWNER_KEY, PAUSE_KEY))}
+        owner, pause = values.get(OWNER_KEY), values.get(PAUSE_KEY)
+        if owner is None:
+            if pause:
+                raise WindowError("preexisting_or_external_provider_pause")
+            return None
+        _owner(owner)
+        if pause not in (None, "", PREFIX + owner):
+            # Unknown-stop errors have priority. Never clear them as if they
+            # were our ordinary temporary maintenance pause.
+            raise WindowError("maintenance_pause_replaced_by_external_reason")
+        return owner
+
+    def claim(self, window_id: str):
+        owner = _owner(window_id)
+        with self.store.tx() as connection:
+            old_owner, pause = _get(connection, OWNER_KEY), _get(connection, PAUSE_KEY)
+            if old_owner == owner and pause in (None, "", PREFIX + owner):
+                return
+            if old_owner is not None or pause:
+                raise WindowError("provider_pause_or_window_already_owned")
+            connection.execute("INSERT INTO meta(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value", (OWNER_KEY, owner))
+
+    def seal(self, window_id: str):
+        """Only after active work drained; prevents future inference reloads."""
+        owner = _owner(window_id)
+        with self.store.tx() as connection:
+            old_owner, pause = _get(connection, OWNER_KEY), _get(connection, PAUSE_KEY)
+            if old_owner != owner or pause not in (None, "", PREFIX + owner):
+                raise WindowError("cannot_seal_changed_or_foreign_pause")
+            connection.execute("INSERT INTO meta(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value", (PAUSE_KEY, PREFIX + owner))
+
+    def release(self, window_id: str):
+        owner = _owner(window_id)
+        with self.store.tx() as connection:
+            old_owner, pause = _get(connection, OWNER_KEY), _get(connection, PAUSE_KEY)
+            if old_owner != owner or pause not in (None, "", PREFIX + owner):
+                raise WindowError("cannot_release_changed_or_foreign_pause")
+            connection.execute("DELETE FROM meta WHERE key=? AND value=?", (PAUSE_KEY, PREFIX + owner))
+            connection.execute("DELETE FROM meta WHERE key=? AND value=?", (OWNER_KEY, owner))
+
+
+class ExactProviderLifecycle(Protocol):
+    def suspend(self, expected: HostBinding) -> None: ...
+    def restore(self, expected: HostBinding) -> None: ...
+
+
+class ExistingCoordinatorHost:
+    """Real existing admission gate; provider management is an explicit port.
+
+    read_observation must freshly inspect service, metadata, configuration,
+    queue and exact model facts. It may not manufacture an idle/healthy proof.
+    It need not set fence_owner: that value is read from original Store here.
+    Lifecycle callbacks run only while TrainingWindow holds the original lock.
+    """
+    def __init__(self, *, coordinator, store,
+                 read_observation: Callable[[], HostObservation],
+                 lifecycle: ExactProviderLifecycle, drain_timeout_seconds: float):
+        if getattr(coordinator, "store", None) is not store:
+            raise WindowError("coordinator_store_mismatch")
+        if not hasattr(coordinator, "lock") or not callable(getattr(coordinator, "complete", None)):
+            raise WindowError("original_model_coordinator_required")
+        if not math.isfinite(drain_timeout_seconds) or drain_timeout_seconds < 0:
+            raise ValueError("explicit finite nonnegative drain budget required")
+        self.coordinator, self.store = coordinator, store
+        self.read_observation, self.lifecycle = read_observation, lifecycle
+        self.drain_timeout = drain_timeout_seconds
+        self.fence = StoreMaintenanceFence(store)
+
+    def inspect(self):
+        observed = self.read_observation()
+        if not isinstance(observed, HostObservation):
+            raise WindowError("native_host_observation_missing")
+        return replace(observed, fence_owner=self.fence.inspect())
+
+    def close_admission(self, window_id):
+        self.fence.claim(window_id)
+
+    def drain(self, window_id):
+        if self.fence.inspect() != window_id:
+            raise WindowError("maintenance_window_not_owned")
+        # Existing in-process work owns this exact lock. Cross-process work is
+        # checked by the original file lock immediately before lifecycle change.
+        acquired = self.coordinator.lock.acquire(timeout=self.drain_timeout)
+        if not acquired:
+            raise WindowError("existing_inference_not_drained")
+        self.coordinator.lock.release()
+        observed = self.inspect()
+        if observed.active_inference or observed.pending_business:
+            raise WindowError("native_business_or_inference_still_pending")
+        self.fence.seal(window_id)
+
+    def suspend_exact_model(self, window_id, binding):
+        if self.fence.inspect() != window_id:
+            raise WindowError("maintenance_window_not_owned")
+        self.lifecycle.suspend(binding)
+
+    def restore_exact_model(self, window_id, binding):
+        if self.fence.inspect() != window_id:
+            raise WindowError("maintenance_window_not_owned")
+        self.lifecycle.restore(binding)
+
+    def open_admission(self, window_id):
+        self.fence.release(window_id)
diff --git a/am-integrated-r6/am_training_window/mac_probe.py b/am-integrated-r6/am_training_window/mac_probe.py
new file mode 100644
index 00000000..70d6dd83
--- /dev/null
+++ b/am-integrated-r6/am_training_window/mac_probe.py
@@ -0,0 +1,244 @@
+"""Read-only, secret-minimizing macOS memory diagnostics.
+
+Admission remains the original R4 resource gate inside its coordination lock.
+The page estimate here is diagnostic only: it must never become a launch gate.
+No inference endpoint, process signal, purge, launchctl, or environment dump is
+used. Process command arguments are deliberately not collected.
+"""
+from __future__ import annotations
+
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import platform
+import re
+import subprocess
+import sys
+from typing import Callable, Sequence
+
+
+SCHEMA = "am.resource-diagnostic.v1"
+COMMANDS: dict[str, tuple[str, ...]] = {
+    "physical": ("/usr/sbin/sysctl", "-n", "hw.memsize"),
+    "swap": ("/usr/sbin/sysctl", "-n", "vm.swapusage"),
+    "pressure": ("/usr/sbin/sysctl", "-n", "kern.memorystatus_vm_pressure_level"),
+    "boot": ("/usr/sbin/sysctl", "-n", "kern.boottime"),
+    "pages": ("/usr/bin/vm_stat",),
+    "processes": ("/bin/ps", "-axo", "pid=,ppid=,uid=,rss=,comm="),
+}
+PROVIDER_NAMES = {"llama-server", "ollama", "ollama_llama_server"}
+
+
+class ProbeError(RuntimeError):
+    """A diagnostic failed; callers must not reinterpret it as a zero value."""
+
+
+def run_readonly(argv: Sequence[str]) -> str:
+    args = tuple(argv)
+    if args not in COMMANDS.values():
+        raise ProbeError("command_not_allowlisted")
+    try:
+        result = subprocess.run(
+            args, shell=False, capture_output=True, text=True,
+            check=False, timeout=5, env={"LC_ALL": "C", "PATH": "/usr/bin:/bin:/usr/sbin:/sbin"},
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise ProbeError(type(exc).__name__) from exc
+    if result.returncode:
+        raise ProbeError(f"command_exit_{result.returncode}")
+    if len(result.stdout) > 4 * 1024 * 1024:
+        raise ProbeError("unexpected_output_size")
+    return result.stdout
+
+
+def parse_pages(text: str) -> dict[str, int]:
+    match = re.search(r"page size of\s+(\d+)\s+bytes", text)
+    if not match or int(match.group(1)) <= 0:
+        raise ProbeError("vm_stat_page_size_missing")
+    page_size = int(match.group(1))
+    counters: dict[str, int] = {}
+    for line in text.splitlines():
+        match = re.fullmatch(r'\s*([^:]+):\s*(\d+)\.?\s*', line)
+        if match:
+            counters[match.group(1).strip().strip('"')] = int(match.group(2))
+    required = ("Pages free", "Pages inactive", "Pages speculative")
+    if any(key not in counters for key in required):
+        raise ProbeError("vm_stat_required_counter_missing")
+    result = {"page_size_bytes": page_size}
+    fields = {
+        "Pages free": "free_bytes",
+        "Pages inactive": "inactive_bytes",
+        "Pages speculative": "speculative_bytes",
+        "Pages active": "active_bytes",
+        "Pages wired down": "wired_bytes",
+        "Pages purgeable": "purgeable_bytes",
+        "Pages occupied by compressor": "compressor_physical_bytes",
+        "Pages stored in compressor": "compressor_logical_bytes",
+        "File-backed pages": "file_backed_bytes",
+    }
+    for counter, field in fields.items():
+        if counter in counters:
+            result[field] = counters[counter] * page_size
+    result["diagnostic_free_inactive_speculative_bytes"] = sum(counters[k] for k in required) * page_size
+    # These counters describe events since boot, not currently resident bytes.
+    for key in ("Pageouts", "Swapins", "Swapouts"):
+        if key in counters:
+            result[key.lower() + "_pages_since_boot"] = counters[key]
+    return result
+
+
+def parse_swap(text: str) -> dict[str, int]:
+    result: dict[str, int] = {}
+    units = {"B": 1, "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}
+    for key in ("total", "used", "free"):
+        match = re.search(rf"\b{key}\s*=\s*(\d+(?:\.\d+)?)\s*([BKMGT])\b", text)
+        if not match:
+            raise ProbeError("swap_field_missing:" + key)
+        result[key + "_bytes"] = int(float(match.group(1)) * units[match.group(2)])
+    return result
+
+
+def parse_processes(text: str) -> list[dict[str, object]]:
+    rows: list[dict[str, object]] = []
+    for line in text.splitlines():
+        if not line.strip():
+            continue
+        values = line.split(None, 4)
+        if len(values) != 5:
+            raise ProbeError("ps_row_shape_invalid")
+        try:
+            pid, ppid, uid, rss_kib = [int(v) for v in values[:4]]
+        except ValueError as exc:
+            raise ProbeError("ps_number_invalid") from exc
+        if pid <= 0 or min(ppid, uid, rss_kib) < 0:
+            raise ProbeError("ps_number_out_of_range")
+        executable = Path(values[4]).name
+        # comm can contain a path. Only its basename leaves this probe.
+        rows.append({"pid": pid, "parent_pid": ppid, "uid": uid,
+                     "rss_bytes": rss_kib * 1024, "executable": executable,
+                     "provider_candidate": executable in PROVIDER_NAMES})
+    return sorted(rows, key=lambda r: int(r["rss_bytes"]), reverse=True)
+
+
+def collect_snapshot(
+    runner: Callable[[Sequence[str]], str] = run_readonly,
+    *, system: str | None = None, captured_at: datetime | None = None,
+) -> dict[str, object]:
+    now = captured_at or datetime.now(timezone.utc)
+    if now.tzinfo is None:
+        raise ValueError("captured_at must have timezone")
+    report: dict[str, object] = {
+        "schema": SCHEMA, "captured_at": now.isoformat(),
+        "system": system or platform.system(), "status": "not_collected",
+        "resource_gate_status": "not_checked",
+        "admission_authority": "original_R4_locked_resource_gate",
+        "model_identity_verified": False, "commands": {}, "errors": {},
+        "limitations": [
+            "RSS is not a recoverable-memory estimate and is not additive across processes.",
+            "A process name alone does not identify the deployed model or service owner.",
+            "The diagnostic page estimate does not authorize training.",
+            "Capture original R4 metrics before and after a separately authorized unload.",
+        ],
+    }
+    if report["system"] != "Darwin":
+        report["status"] = "unsupported_platform"
+        return report
+    raw: dict[str, str] = {}
+    errors: dict[str, str] = {}
+    for key, argv in COMMANDS.items():
+        try:
+            raw[key] = runner(argv)
+            report["commands"][key] = {"exit": 0, "stdout_sha256": hashlib.sha256(raw[key].encode()).hexdigest()}
+        except Exception as exc:
+            # Do not write arbitrary exception strings (which may include local data).
+            errors[key] = type(exc).__name__
+            report["commands"][key] = {"exit": "failed"}
+    parsers = {"physical": lambda s: int(s.strip()), "swap": parse_swap,
+               "pressure": lambda s: int(s.strip()), "pages": parse_pages,
+               "processes": parse_processes}
+    parsed: dict[str, object] = {}
+    for key, parser in parsers.items():
+        if key in raw:
+            try:
+                parsed[key] = parser(raw[key])
+            except Exception as exc:
+                errors[key] = type(exc).__name__
+    if "physical" in parsed and int(parsed["physical"]) <= 0:
+        errors["physical"] = "out_of_range"
+        del parsed["physical"]
+    report["physical_bytes"] = parsed.get("physical")
+    report["swap"] = parsed.get("swap")
+    report["pressure_level"] = parsed.get("pressure")
+    report["memory"] = parsed.get("pages")
+    if "boot" in raw:
+        boot = re.search(r"sec\s*=\s*(\d+)", raw["boot"])
+        if boot:
+            report["boot_identity_sha256"] = hashlib.sha256(boot.group(1).encode()).hexdigest()
+        else:
+            errors["boot"] = "parse_error"
+    rows = parsed.get("processes", [])
+    report["top_processes"] = rows[:15]
+    report["provider_candidates"] = [r for r in rows if r["provider_candidate"]]
+    report["errors"] = errors
+    report["status"] = "partial" if errors else "complete"
+    return report
+
+
+def compare_snapshots(before: dict, after: dict) -> dict[str, object]:
+    """Return observations without attributing memory changes to a process."""
+    if any(r.get("schema") != SCHEMA or r.get("status") != "complete" for r in (before, after)):
+        raise ProbeError("complete_matching_schema_snapshots_required")
+    if before.get("physical_bytes") != after.get("physical_bytes") or not before.get("boot_identity_sha256") or before["boot_identity_sha256"] != after.get("boot_identity_sha256"):
+        raise ProbeError("machine_or_boot_changed")
+    b_time, a_time = (datetime.fromisoformat(r["captured_at"]) for r in (before, after))
+    if b_time.tzinfo is None or a_time.tzinfo is None or a_time <= b_time:
+        raise ProbeError("snapshot_order_invalid")
+    b_keys = {(r["pid"], r["executable"]) for r in before["provider_candidates"]}
+    a_keys = {(r["pid"], r["executable"]) for r in after["provider_candidates"]}
+    key = "diagnostic_free_inactive_speculative_bytes"
+    return {
+        "schema": "am.resource-delta.v1", "elapsed_seconds": (a_time - b_time).total_seconds(),
+        "diagnostic_page_estimate_change_bytes": after["memory"][key] - before["memory"][key],
+        "swap_used_change_bytes": after["swap"]["used_bytes"] - before["swap"]["used_bytes"],
+        "pressure_before": before["pressure_level"], "pressure_after": after["pressure_level"],
+        "provider_rows_disappeared": [list(v) for v in sorted(b_keys - a_keys)],
+        "provider_rows_appeared": [list(v) for v in sorted(a_keys - b_keys)],
+        "pid_identity_note": "PID plus basename is observational only; PID reuse and model identity are not resolved.",
+        "resource_gate_status": "not_checked", "causal_attribution": "not_established",
+        "instruction": "Use original R4 locked metrics to determine launch eligibility; do not add RSS to available memory.",
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="action", required=True)
+    snap = sub.add_parser("snapshot", help="Read-only local macOS snapshot")
+    snap.add_argument("--output", type=Path)
+    compare = sub.add_parser("compare", help="Compare two saved read-only snapshots")
+    compare.add_argument("before", type=Path)
+    compare.add_argument("after", type=Path)
+    compare.add_argument("--output", type=Path)
+    args = parser.parse_args(argv)
+    try:
+        if args.action == "snapshot":
+            result = collect_snapshot()
+        else:
+            result = compare_snapshots(json.loads(args.before.read_text()), json.loads(args.after.read_text()))
+        encoded = json.dumps(result, ensure_ascii=False, indent=2) + "\n"
+        if args.output:
+            # A report file is the only write operation; never overwrite evidence.
+            with args.output.open("x", encoding="utf-8") as output:
+                output.write(encoded)
+        else:
+            sys.stdout.write(encoded)
+        return 0 if result.get("status", "complete") == "complete" else 2
+    except (OSError, ValueError, ProbeError) as exc:
+        print(json.dumps({"status": "failed", "error_type": type(exc).__name__}), file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
diff --git a/am-integrated-r6/am_training_window/native_r5.py b/am-integrated-r6/am_training_window/native_r5.py
new file mode 100644
index 00000000..a8ad7901
--- /dev/null
+++ b/am-integrated-r6/am_training_window/native_r5.py
@@ -0,0 +1,100 @@
+"""Actual original R5 CLI callback and independent original R4 stop proof.
+
+This is supplied to TrainingWindow.train, after its maintenance lock is released.
+The diagnostic control port never imports or invokes it. No R4 argv is cached.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+import uuid
+
+from .r5_gate import OriginalR5InputGate
+from .window import ExecutionObservation, WindowError
+
+
+def group_gone(pid):
+    if type(pid) is not int or pid<=1:return False
+    try:os.killpg(pid,0)
+    except ProcessLookupError:return True
+    except PermissionError:return False
+    return False
+
+
+def phase_stop_proof(result, check_group=group_gone):
+    phases=result.get('phases')
+    if not isinstance(phases,list) or not phases:return False
+    names=[p.get('phase') for p in phases]
+    if names!=['fit','reload']:return False
+    if any(p.get('attempted') is not True and not (p.get('phase')=='reload'
+            and p.get('attempted') is False and p.get('status')=='skipped_fit_not_completed_or_stop_unconfirmed') for p in phases):return False
+    attempted=[p for p in phases if p.get('attempted') is True]
+    if not attempted:return False
+    return all(p.get('stop_confirmed') is True and check_group(p.get('pid')) for p in attempted)
+
+
+class OriginalPilotExecutor:
+    def __init__(self, plan_path, evidence_directory):
+        self.plan=Path(plan_path)
+        self.evidence=Path(evidence_directory)
+        if not self.plan.is_absolute() or not self.evidence.is_absolute():raise ValueError('absolute original paths required')
+        self.process=None;self.run_directory=None;self.result=None;self.cli_start_attempts=0
+
+    def stopped(self):
+        # Called independently by TrainingWindow before any Q8 restoration.
+        if self.process is None:return self.cli_start_attempts==0
+        if self.process.poll() is None:return False
+        if not group_gone(self.process.pid):return False
+        if self.result is None:
+            # A denied original CLI created no run. Otherwise absence of result
+            # is an unknown worker state, even if the parent has exited.
+            return self.run_directory is not None and not self.run_directory.exists()
+        return phase_stop_proof(self.result)
+
+    def __call__(self):
+        if self.process is not None or self.cli_start_attempts:raise WindowError('pilot_callback_already_used')
+        OriginalR5InputGate(self.plan)()  # Missing inputs do not even spawn a CLI.
+        from am_style_r5 import pilot
+        from am_style_r5.common import read_json
+        plan=read_json(self.plan)
+        self.run_directory=Path(plan['run_directory'])
+        if self.run_directory.exists():raise WindowError('original_run_directory_already_exists')
+        python=plan['python_interpreter']['path']
+        package_root=Path(pilot.__file__).resolve().parents[1]
+        self.evidence.mkdir(mode=0o700,parents=True,exist_ok=True)
+        if self.evidence.is_symlink():raise WindowError('execution_evidence_symlink')
+        label=uuid.uuid4().hex;log=self.evidence/(label+'.log')
+        env=dict(os.environ,PYTHONPATH=str(package_root),PYTHONDONTWRITEBYTECODE='1')
+        command=[python,'-m','am_style_r5','pilot-execute','--plan',str(self.plan),'--execute']
+        started=time.time()
+        fd=os.open(log,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
+        with os.fdopen(fd,'wb') as stream:
+            self.cli_start_attempts+=1
+            self.process=subprocess.Popen(command,cwd=package_root,env=env,stdin=subprocess.DEVNULL,
+                stdout=stream,stderr=subprocess.STDOUT,start_new_session=True)
+            # The unchanged R4 owns the reviewed fit/reload timeout policy.
+            # On interruption the caller retains maintenance until stopped().
+            code=self.process.wait()
+        result_path=self.run_directory/'result.json'
+        result_hash=None
+        if result_path.is_file() and not result_path.is_symlink() and result_path.stat().st_mtime>=started:
+            self.result=read_json(result_path)
+            if self.result.get('schema')!='am-style-mlx-r4-result/1':raise WindowError('original_r4_result_schema')
+            result_hash=hashlib.sha256(result_path.read_bytes()).hexdigest()
+        stopped=self.stopped()
+        completed=(code==0 and stopped and self.result is not None and self.result.get('mechanics_closed') is True
+                   and [p.get('phase') for p in self.result['phases']]==['fit','reload']
+                   and all(p.get('attempted') is True and p.get('status')=='completed' for p in self.result['phases']))
+        evidence={'schema':'am-original-r5-execution-observation/1','started':started,'finished':time.time(),
+            'cli_pid':self.process.pid,'cli_returncode':code,'cli_start_attempts':self.cli_start_attempts,
+            'original_r4_result_sha256':result_hash,'original_phases':None if self.result is None else self.result.get('phases'),
+            'original_cli_group_gone':group_gone(self.process.pid),'independent_worker_groups_gone':stopped,
+            'status':'completed' if completed else 'blocked_or_failed','log_sha256':hashlib.sha256(log.read_bytes()).hexdigest()}
+        raw=(json.dumps(evidence,ensure_ascii=False,sort_keys=True,indent=2)+'\n').encode()
+        path=self.evidence/(label+'.json');fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
+        with os.fdopen(fd,'wb') as stream:stream.write(raw)
+        return ExecutionObservation(evidence['status'],stopped,hashlib.sha256(raw).hexdigest())
