+/* Product module: every selector stays inside .ledger-workbench.
+ * Inherit the WB host's typography, button classes and --v2-* values.
+ * Fallbacks below are limited to verified R4 product increment values.
+ */
+.ledger-workbench {
+  --lw-line: var(--wb-line, var(--v2-line, #d8e1dc));
+  --lw-muted: var(--wb-muted, var(--v2-muted, #66736c));
+  --lw-soft: var(--wb-soft, var(--v2-soft, #f4f7f5));
+  --lw-attention: var(--v2-warning-text, #9b422d);
+  width: 100%;
+  max-width: 1120px;
+  min-width: 0;
+  margin-inline: auto;
+  font: inherit;
+  line-height: 1.6;
+  color: inherit;
+}
+.ledger-workbench *,
+.ledger-workbench *::before,
+.ledger-workbench *::after { box-sizing: border-box; }
+.ledger-workbench h1,
+.ledger-workbench h2,
+.ledger-workbench h3,
+.ledger-workbench h4,
+.ledger-workbench p { margin: 0; }
+.ledger-workbench button:not(.v2-button),
+.ledger-workbench input,
+.ledger-workbench select,
+.ledger-workbench textarea { font: inherit; color: inherit; }
+.ledger-workbench button { cursor: pointer; }
+.ledger-workbench button:disabled { cursor: default; opacity: .55; }
+.ledger-workbench button:focus-visible,
+.ledger-workbench input:focus-visible,
+.ledger-workbench select:focus-visible,
+.ledger-workbench textarea:focus-visible,
+.ledger-workbench summary:focus-visible {
+  outline: 2px solid currentColor;
+  outline-offset: 3px;
+}
+.ledger-workbench .lw-header,
+.ledger-workbench .lw-header-actions,
+.ledger-workbench .lw-main-actions,
+.ledger-workbench .lw-panel-header,
+.ledger-workbench .lw-pane-toolbar,
