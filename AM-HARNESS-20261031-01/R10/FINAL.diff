+                draft['sources'],draft['answers'],min(expires,current['expires']),draft['stage']))
+            c.execute('INSERT INTO amdoc_context VALUES(?,?,?)',(fresh_id,canonical(context),expires))
+        fresh=self.logic.get(row,fresh_id)
+        self.logic.queue(dict(row,expires=expires),fresh)
