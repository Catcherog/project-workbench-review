+import tempfile
+import unittest
+from pathlib import Path
+
+from am_harness.controls import IngressController, parse_control
+from am_harness.store import DurableStore, Scope, StoreError
+
+
+class ControlTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.now = 1000.0
+        self.scope = Scope("tenant", "app", "owner", "chat", "thread")
+        self.store = DurableStore(Path(self.tmp.name) / "runs.sqlite", clock=lambda: self.now)
+        self.ops = []
+        self.control = IngressController(self.store, authorize=lambda s, op: self.ops.append((s.key, op)))
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def submit(self, event="event", text="查项目进展"):
+        return self.store.submit(self.scope, event, text, deadline=1100, expires_at=1300)
+
+    def test_bare_cancel_and_compound_text_remain_original_semantics(self):
+        for text in ("取消", "先别发", "取消这个", "告诉我如何停止当前任务", "停止当前任务并发送消息", "/cancel", "修改当前任务："):
+            self.assertIsNone(parse_control(text))
+        self.assertEqual(parse_control("更正当前任务：查看交期").replacement, "查看交期")
+
+    def test_authenticated_cancel_without_worker_lock_and_duplicate(self):
+        run = self.submit()
+        lease = self.store.claim("worker")
+        reply = self.control.handle(self.scope, "control", "停止当前任务")
+        self.assertEqual(reply.status, "cancelled")
+        self.assertEqual(self.store.lane_status()["state"], "active")
+        again = self.control.handle(self.scope, "control", "停止当前任务")
+        self.assertEqual(again.status, "already_handled")
+        self.assertEqual(again.cancel_epoch, reply.cancel_epoch)
+        self.assertFalse(self.store.finish(lease, result={"stale": True}))
+        self.assertIsNone(self.store.get(self.scope, run.id).result)
+
+    def test_noop_redelivery_cannot_cancel_a_later_task(self):
+        reply = self.control.handle(self.scope, "before-task", "停止当前任务")
+        self.assertEqual(reply.status, "no_active_run")
+        run = self.submit()
+        replay = self.control.handle(self.scope, "before-task", "停止当前任务")
+        self.assertEqual(replay.status, "no_active_run")
+        self.assertEqual(self.store.get(self.scope, run.id).state, "queued")
+
+    def test_ambiguous_noop_stays_ambiguous_after_other_task_finishes(self):
+        one, two = self.submit("1"), self.submit("2")
+        reply = self.control.handle(self.scope, "control", "停止当前任务")
+        self.assertEqual(reply.status, "clarification")
+        self.store.cancel(self.scope, "other-cancel", two.id)
+        replay = self.control.handle(self.scope, "control", "停止当前任务")
+        self.assertEqual(replay.status, "clarification")
+        self.assertEqual(self.store.get(self.scope, one.id).state, "queued")
+
+    def test_revise_preserves_expiry_and_does_not_repeat(self):
+        run = self.submit()
+        self.now += 10
+        reply = self.control.handle(self.scope, "steer", "更正当前任务：查询关键日期")
+        updated = self.store.get(self.scope, run.id)
+        self.assertEqual(updated.input_text, "查询关键日期")
+        self.assertEqual(updated.expires_at, 1300)
+        self.assertEqual(updated.deadline, 1130)
+        self.assertEqual(reply.revision, 2)
+        again = self.control.handle(self.scope, "steer", "更正当前任务：查询关键日期")
+        self.assertEqual(again.revision, 2)
+        with self.assertRaises(StoreError):
+            self.control.handle(self.scope, "steer", "更正当前任务：发送消息")
+
+    def test_scope_and_auth_are_checked_for_controls(self):
+        run = self.submit()
+        other = Scope("tenant", "app", "coworker", "chat", "thread")
+        with self.assertRaises(StoreError):
+            self.control.handle(other, "control", "取消任务 " + run.id)
+        def deny(scope, operation):
+            raise RuntimeError("AUTHORIZATION_DENIED")
+        controller = IngressController(self.store, authorize=deny)
+        with self.assertRaisesRegex(RuntimeError, "AUTHORIZATION_DENIED"):
+            controller.handle(self.scope, "deny", "停止当前任务")
+        self.assertEqual(self.store.get(self.scope, run.id).state, "queued")
+
+    def test_multiple_tasks_can_revise_one_explicit_target(self):
+        one,two=self.submit("one"),self.submit("two")
+        clarification=self.control.handle(self.scope,"ambiguous","更正当前任务：新要求")
+        self.assertIn("更正任务",clarification.text)
+        reply=self.control.handle(self.scope,"specified","更正任务 "+two.id+"：新要求")
+        self.assertEqual(reply.run_id,two.id)
+        self.assertEqual(self.store.get(self.scope,one.id).revision,1)
+        self.assertEqual(self.store.get(self.scope,two.id).input_text,"新要求")
diff --git a/am-harness-r1/tests/test_effects.py b/am-harness-r1/tests/test_effects.py
new file mode 100644
index 00000000..87bbf027
--- /dev/null
+++ b/am-harness-r1/tests/test_effects.py
@@ -0,0 +1,108 @@
+from pathlib import Path
+import sqlite3
+import tempfile
+import unittest
+
+from am_harness.effects import FencedOutbox
+from am_harness.store import DurableStore, Scope
+
+
+class EffectTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory(); self.now=1000
+        self.store=DurableStore(Path(self.tmp.name)/"am.sqlite",clock=lambda:self.now)
+        self.scope=Scope("tenant","app","actor","chat","thread")
+        with sqlite3.connect(self.store.path) as c:
+            c.execute("""CREATE TABLE outbox(id TEXT PRIMARY KEY,app TEXT,tenant TEXT,user TEXT,chat TEXT,
+                         expires REAL,state TEXT,error TEXT,message_id TEXT,body TEXT)""")
+        self.out=FencedOutbox(self.store,binding_verifier=lambda c,r,o:None)
+        self.run=self.store.submit(self.scope,"event","question",deadline=1120,expires_at=1600)
+        self.lease=self.store.claim("worker")
+
+    def tearDown(self): self.tmp.cleanup()
+
+    def enqueue(self,conn,run):
+        conn.execute("INSERT INTO outbox VALUES(?,?,?,?,?,?,'pending',NULL,NULL,?)",
+                     ("out-1","app","tenant","actor","chat",run.expires_at,"synthetic result"))
+        return "out-1"
+
+    def commit(self):
+        self.assertTrue(self.store.finish(self.lease,result={"ok":True},
+                        on_commit=lambda c,r:self.out.enqueue(c,r,self.enqueue)))
+
+    def state(self):
+        with sqlite3.connect(self.store.path) as c:
+            return c.execute("SELECT state FROM outbox WHERE id='out-1'").fetchone()[0]
+
+    def test_cancel_before_finish_atomically_blocks_publication(self):
+        self.store.cancel(self.scope,"cancel",self.run.id,on_change=self.out.suppress_pending)
+        self.assertFalse(self.store.finish(self.lease,on_commit=lambda c,r:self.out.enqueue(c,r,self.enqueue)))
+        with sqlite3.connect(self.store.path) as c:
+            self.assertEqual(c.execute("SELECT COUNT(*) FROM outbox").fetchone()[0],0)
+
+    def test_cancel_after_enqueue_rejects_unsent_original_outbox(self):
+        self.commit()
+        self.store.cancel(self.scope,"cancel",self.run.id,on_change=self.out.suppress_pending)
+        self.assertEqual(self.state(),"rejected")
+        with sqlite3.connect(self.store.path,isolation_level=None) as c:
+            c.execute("BEGIN IMMEDIATE")
+            self.assertFalse(self.out.before_dispatch(c,"out-1")); c.commit()
+
+    def test_dispatch_wins_then_cancel_records_uncertainty_and_preserves_receipt(self):
+        self.commit()
+        with sqlite3.connect(self.store.path,isolation_level=None) as c:
+            c.execute("BEGIN IMMEDIATE")
+            self.assertTrue(self.out.before_dispatch(c,"out-1"))
+            c.execute("UPDATE outbox SET state='sending' WHERE id='out-1'")
+            c.commit()
+        self.store.cancel(self.scope,"cancel",self.run.id,on_change=self.out.suppress_pending)
+        self.assertEqual(self.state(),"sending")
+        with sqlite3.connect(self.store.path,isolation_level=None) as c:
+            self.assertEqual(c.execute("SELECT state FROM am_harness_outbox").fetchone()[0],"needs_reconciliation")
+            c.execute("BEGIN IMMEDIATE")
+            c.execute("UPDATE outbox SET state='sent',message_id='receipt-1' WHERE id='out-1'")
+            self.out.observe_receipt(c,"out-1","receipt-1",verified=True)
+            c.commit()
+            self.assertEqual(c.execute("SELECT state,verified FROM am_harness_outbox").fetchone(),("sent",1))
+
+    def test_expired_delivery_rejected_without_touching_other_am_rows(self):
+        self.commit(); self.now=1601
+        with sqlite3.connect(self.store.path,isolation_level=None) as c:
+            c.execute("BEGIN IMMEDIATE")
+            self.assertFalse(self.out.before_dispatch(c,"out-1"))
+            self.assertTrue(self.out.before_dispatch(c,"not-a-harness-row"))
+            c.commit()
+        self.assertEqual(self.state(),"rejected")
+
+    def test_finished_result_can_deliver_after_execution_budget_within_ttl(self):
+        self.commit(); self.now=1121
+        with sqlite3.connect(self.store.path,isolation_level=None) as c:
+            c.execute("BEGIN IMMEDIATE")
+            self.assertTrue(self.out.before_dispatch(c,"out-1"))
+            c.execute("UPDATE outbox SET state='sending' WHERE id='out-1'")
+            c.commit()
+
+    def test_bound_payload_change_prevents_dispatch(self):
+        self.commit()
+        with sqlite3.connect(self.store.path,isolation_level=None) as c:
+            c.execute("UPDATE outbox SET body='altered reply' WHERE id='out-1'")
+            c.execute("BEGIN IMMEDIATE")
+            self.assertFalse(self.out.before_dispatch(c,"out-1"));c.commit()
+        self.assertEqual(self.state(),"rejected")
+
+    def test_scope_and_same_database_guards(self):
+        with self.store.transaction_guard(self.lease.fence) as c:
+            self.enqueue(c,self.lease.run)
+            c.execute("UPDATE outbox SET chat='someone-else' WHERE id='out-1'")
+            with self.assertRaisesRegex(RuntimeError,"OUTBOX_SCOPE_MISMATCH"):
+                self.out.bind(c,self.lease.run,"out-1")
+        with sqlite3.connect(Path(self.tmp.name)/"other.sqlite",isolation_level=None) as c:
+            c.execute("BEGIN IMMEDIATE")
+            with self.assertRaisesRegex(RuntimeError,"OUTBOX_MUST_SHARE_RUN_DATABASE"):
+                self.out.before_dispatch(c,"out-1")
+            c.rollback()
+
+    def test_missing_transaction_is_rejected(self):
+        with sqlite3.connect(self.store.path,isolation_level=None) as c:
+            with self.assertRaisesRegex(RuntimeError,"OUTBOX_TRANSACTION_REQUIRED"):
+                self.out.before_dispatch(c,"out-1")
