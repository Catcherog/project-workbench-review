@@ -0,0 +1,200 @@
+"""Optional binding to AM's existing ConversationAgent, not a new provider.
+
+The host supplies fresh identity and grants via ``context_resolver``.  A
+LegacyConversationBridge resolver must also enter its request ContextVar.
+Queue snapshots alone are never authorization credentials.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager, nullcontext
+from contextvars import ContextVar
+from dataclasses import dataclass
+import hashlib
+import math
+import time
+from typing import Callable
+import uuid
+
+
+class BindingError(RuntimeError):
+    def __init__(self, code: str):
+        self.code = code
+        super().__init__(code)
+
+
+@dataclass(frozen=True)
+class _ReadOnlyBinding:
+    context: object
+    expires_at: float
+    trace_id: str
+
+
+_READONLY_PHASES = frozenset({"before_handle_readonly", "after_handle_readonly",
+    "before_fastpath_prepare", "after_fastpath_prepare", "before_fastpath_consume",
+    "after_fastpath_consume", "before_finish", "after_finish"})
+
+
+class LifecycleBinding:
+    """Bind one durable run fence to this execution context.
+
+    The patched AM engine calls this object outside tool error swallowing.
+    The callback must raise when a fence is stale, cancelled or expired.
+    Checkpoints cooperate with cancellation; this is not a network abort or
+    an atomic external-effect commit.  Final delivery needs the host fence.
+    """
+
+    def __init__(self, guard: Callable, *, strict_bound: bool = True, observer=None, clock=time.time):
+        if not callable(guard) or type(strict_bound) is not bool:
+            raise ValueError("INVALID_LIFECYCLE_CONFIG")
+        self.guard, self.strict_bound, self.observer = guard, strict_bound, observer
+        self.clock = clock
+        self._current = ContextVar("am_harness_bound_fence", default=None)
+
+    @contextmanager
+    def bind(self, fence):
+        token = self._current.set(fence)
+        try:
+            yield self
+        finally:
+            self._current.reset(token)
+
+    @contextmanager
+    def bind_readonly(self, ctx, *, expires_at: float):
+        """A <=5s ingress read; cannot enter model/control/tool/effect phases."""
+        now = self.clock()
+        if type(expires_at) not in (int, float) or not math.isfinite(expires_at) or expires_at <= now:
+            raise BindingError("HARNESS_READONLY_EXPIRED")
+        end = min(expires_at, now + 5, ctx.content_expires_at or now + 5)
+        if end <= now:
+            raise BindingError("HARNESS_READONLY_EXPIRED")
+        token = self._current.set(_ReadOnlyBinding(ctx, end, "read-" + uuid.uuid4().hex))
+        try:
+            yield self
+        finally:
+            self._current.reset(token)
+
+    @property
+    def fence(self):
+        value = self._current.get()
+        return None if isinstance(value, _ReadOnlyBinding) else value
+
+    def __call__(self, ctx, phase: str, args: dict) -> None:
+        fence = self._current.get()
+        if fence is None:
+            if self.strict_bound:
+                raise BindingError("HARNESS_UNBOUND_RUN")
+            return
+        if isinstance(fence, _ReadOnlyBinding):
+            if ctx != fence.context:
+                raise BindingError("HARNESS_SCOPE_MISMATCH")
+            if phase not in _READONLY_PHASES:
+                raise BindingError("HARNESS_READONLY_PHASE_DENIED")
+            if self.clock() >= fence.expires_at:
+                raise BindingError("HARNESS_READONLY_EXPIRED")
+            if self.observer:
+                try:
+                    self.observer({"run_id": fence.trace_id, "phase": phase, "mode": "readonly"})
+                except Exception:
+                    pass
+            return
+        if getattr(fence, "scope_key", None) != ctx.session_id:
+            raise BindingError("HARNESS_SCOPE_MISMATCH")
+        if ctx.content_expires_at is not None and ctx.content_expires_at <= self.clock():
+            raise BindingError("HARNESS_CONTEXT_EXPIRED")
+        self.guard(fence)
+        if self.observer:
+            # Metadata only; never send user input or arbitrary tool arguments
+            # to telemetry.  Observability failure must not retry a side effect.
+            try:
+                self.observer({"run_id": fence.run_id, "revision": fence.revision,
+                               "cancel_epoch": fence.cancel_epoch, "phase": phase})
+            except Exception:
+                pass
+
+
+class OneShotReadRunner:
+    """Short read at ingress, before durable queue submission.
+
+    The caller has already authenticated the original AM inbox row and entered
+    LegacyConversationBridge._active. The original ConversationStore commits
+    dedupe/history; the caller renders/enqueues/delivers through the existing
+    outbox. ``None`` means no event was claimed and the model path may start.
+    """
+
+    def __init__(self, agent, hooks: LifecycleBinding, *, clock=time.time):
+        if getattr(agent, "lifecycle", None) is not hooks or not callable(getattr(agent, "handle_fastpath", None)):
+            raise BindingError("HARNESS_FASTPATH_ENTRY_NOT_INSTALLED")
+        self.agent, self.hooks, self.clock = agent, hooks, clock
+
+    def try_handle(self, ctx, event_id: str, text: str):
+        with self.hooks.bind_readonly(ctx, expires_at=self.clock() + 5):
+            self.hooks(ctx, "before_handle_readonly", {})
+            reply = self.agent.handle_fastpath(ctx, event_id, text)
+            self.hooks(ctx, "after_handle_readonly", {})
+            return reply
+
+
+def engine_event_id(snapshot) -> str:
+    """Stable revision-specific ID prevents an old AM event poisoning a steer."""
+    run_id = str(snapshot.id)
+    if len(run_id) > 180:
+        run_id = hashlib.sha256(run_id.encode()).hexdigest()
+    return f"harness:{run_id}:v{snapshot.revision}"
+
+
+class AmAgentRunner:
+    """One durable turn through the original patched ConversationAgent.
+
+    Returned ``reply.event_id`` remains the internal revision event ID.  The
+    host may join it to origin_event_id in the existing outbox; do not pass it
+    to an unmodified LegacyConversationBridge.process(), which expects the
+    exact incoming event ID.  See the explicit integration checklist.
+    """
+
+    def __init__(self, agent, context_resolver, hooks: LifecycleBinding, *, clock=time.time):
+        if getattr(agent, "lifecycle", None) is not hooks:
+            raise BindingError("HARNESS_ENGINE_HOOKS_NOT_INSTALLED")
+        if not callable(context_resolver):
+            raise ValueError("INVALID_CONTEXT_RESOLVER")
+        self.agent, self.context_resolver, self.hooks, self.clock = agent, context_resolver, hooks, clock
+
+    def run(self, snapshot) -> dict:
+        return self._execute(snapshot, fastpath_only=False)
+
+    def try_fastpath(self, snapshot) -> dict | None:
+        """Try an independent read without entering the model turn lane.
+
+        On a grammar/shape miss no AM event was claimed; the same durable
+        snapshot may be queued normally. The host must not start a normal
+        worker for this same run until this attempt returns.
+        """
+        if not callable(getattr(self.agent, "handle_fastpath", None)):
+            raise BindingError("HARNESS_FASTPATH_ENTRY_NOT_INSTALLED")
+        return self._execute(snapshot, fastpath_only=True)
+
+    def _execute(self, snapshot, *, fastpath_only: bool) -> dict | None:
+        remaining = min(snapshot.deadline, snapshot.expires_at) - self.clock()
+        if remaining <= 0:
+            raise BindingError("HARNESS_DEADLINE_EXPIRED")
+        resolved = self.context_resolver(snapshot)
+        manager = resolved if hasattr(resolved, "__enter__") else nullcontext(resolved)
+        with manager as ctx, self.hooks.bind(snapshot.fence):
+            if ctx.session_id != snapshot.scope.key:
+                raise BindingError("HARNESS_SCOPE_MISMATCH")
+            self.hooks(ctx, "before_handle", {})
+            remaining = min(snapshot.deadline, snapshot.expires_at,
+                            ctx.content_expires_at or snapshot.expires_at) - self.clock()
+            if remaining <= 0:
+                raise BindingError("HARNESS_DEADLINE_EXPIRED")
+            event_id = engine_event_id(snapshot)
+            if fastpath_only:
+                reply = self.agent.handle_fastpath(ctx, event_id, snapshot.input_text)
+            else:
+                reply = self.agent.handle(ctx, event_id, snapshot.input_text, timeout=remaining)
+            self.hooks(ctx, "after_handle", {})
+            if reply is None:
+                return None
+            return {"run_id": snapshot.id, "revision": snapshot.revision,
+                    "cancel_epoch": snapshot.cancel_epoch,
+                    "origin_event_id": snapshot.event_id, "engine_event_id": event_id,
+                    "reply": reply.to_dict()}
diff --git a/FS-AGENT-GROK-POC-20261017-01_R1_Studio/src/am_harness/checkpoints.py b/FS-AGENT-GROK-POC-20261017-01_R1_Studio/src/am_harness/checkpoints.py
new file mode 100644
index 00000000..1ed07f32
--- /dev/null
+++ b/FS-AGENT-GROK-POC-20261017-01_R1_Studio/src/am_harness/checkpoints.py
@@ -0,0 +1,203 @@
+"""A disposable cache of reproducible phases, not an execution/approval journal.
+
+Only read results and explicitly pure local computation may be stored. Every hit
+requires current source versions, the same permission fingerprint and renewed
+project authorization. Dependency TTLs cap the checkpoint's lifetime.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from dataclasses import dataclass
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+import sqlite3
+import time
+from typing import Any, Callable, Iterator, Mapping, Sequence
+
+
+class CheckpointError(ValueError):
+    pass
+
+
+def canonical(value: Any) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def digest(value: Any) -> str:
+    return hashlib.sha256(canonical(value).encode("utf-8")).hexdigest()
+
+
+@dataclass(frozen=True)
+class Checkpoint:
+    run_id: str
+    phase: str
+    value: Any
+    input_hash: str
+    dependencies: dict[str, str]
+    project_ids: tuple[str, ...]
+    expires_at: float
+    created_at: float
+    version: int
+    effect: str
+
+
+class CheckpointStore:
+    SCHEMA_VERSION = 1
+
+    def __init__(self, path: str | Path, *, max_bytes: int = 262144, timeout: float = 5.0,
+                 clock: Callable[[], float] = time.time) -> None:
+        self.path = str(path)
+        if self.path == ":memory:":
+            raise CheckpointError("USE_FILE_BACKED_SQLITE")
+        if type(max_bytes) is not int or max_bytes < 1 or timeout <= 0:
+            raise CheckpointError("INVALID_CONFIGURATION")
+        self.max_bytes, self.timeout, self.clock = max_bytes, timeout, clock
+        Path(self.path).parent.mkdir(parents=True, exist_ok=True)
+        with self._connect() as db:
+            db.execute("PRAGMA journal_mode=WAL")
+            db.execute("BEGIN IMMEDIATE")
+            db.execute("CREATE TABLE IF NOT EXISTS am_harness_checkpoint_meta (key TEXT PRIMARY KEY, value INTEGER NOT NULL)")
+            row = db.execute("SELECT value FROM am_harness_checkpoint_meta WHERE key='schema_version'").fetchone()
+            if row is not None and row[0] != self.SCHEMA_VERSION:
+                raise CheckpointError("UNSUPPORTED_CHECKPOINT_SCHEMA")
+            db.execute("INSERT OR IGNORE INTO am_harness_checkpoint_meta VALUES ('schema_version', ?)", (self.SCHEMA_VERSION,))
+            db.execute("""CREATE TABLE IF NOT EXISTS am_harness_checkpoints (
+                scope_key TEXT NOT NULL, permission_fingerprint TEXT NOT NULL,
+                run_id TEXT NOT NULL, phase TEXT NOT NULL, input_hash TEXT NOT NULL,
+                dependencies_json TEXT NOT NULL, dependency_expiries_json TEXT NOT NULL,
+                projects_json TEXT NOT NULL, value_json TEXT NOT NULL,
+                expires_at REAL NOT NULL, created_at REAL NOT NULL,
+                version INTEGER NOT NULL, effect TEXT NOT NULL,
+                PRIMARY KEY (scope_key, run_id, phase))""")
+            db.execute("CREATE INDEX IF NOT EXISTS am_harness_checkpoint_expiry ON am_harness_checkpoints(expires_at)")
+
+    @contextmanager
+    def _connect(self) -> Iterator[sqlite3.Connection]:
+        db = sqlite3.connect(self.path, timeout=self.timeout, isolation_level=None)
+        db.row_factory = sqlite3.Row
+        db.execute("PRAGMA busy_timeout=" + str(int(self.timeout * 1000)))
+        try:
+            yield db
+            if db.in_transaction:
+                db.commit()
+        except BaseException:
+            if db.in_transaction:
+                db.rollback()
+            raise
+        finally:
+            db.close()
+
+    @staticmethod
+    def _identity(scope_key: str, run_id: str, phase: str, permission_fingerprint: str) -> None:
+        if any(not isinstance(s, str) or not s or len(s) > 256 for s in (scope_key, run_id, permission_fingerprint)):
+            raise CheckpointError("INVALID_CHECKPOINT_IDENTITY")
+        if not isinstance(phase, str) or not re.fullmatch(r"[a-z][a-z0-9_.-]{0,63}", phase):
+            raise CheckpointError("INVALID_PHASE")
+
+    def _now(self, now: float | None) -> float:
+        value = self.clock() if now is None else now
+        if type(value) not in (int, float) or not math.isfinite(value) or value <= 0:
+            raise CheckpointError("INVALID_CLOCK")
+        return value
+
+    def put(self, *, scope_key: str, permission_fingerprint: str, run_id: str, phase: str,
+            input_value: Any, value: Any, dependencies: Mapping[str, str],
+            dependency_expiries: Mapping[str, float], project_ids: Sequence[str],
+            expires_at: float, effect: str = "read", now: float | None = None) -> Checkpoint:
+        self._identity(scope_key, run_id, phase, permission_fingerprint)
+        now = self._now(now)
+        if effect not in {"read", "pure_local"}:
+            raise CheckpointError("EFFECT_NOT_CACHEABLE")
+        if type(expires_at) not in (int, float) or not math.isfinite(expires_at) or expires_at <= now:
+            raise CheckpointError("INVALID_CHECKPOINT_EXPIRY")
+        deps = dict(dependencies)
+        expiries = dict(dependency_expiries)
+        if set(deps) != set(expiries):
+            raise CheckpointError("DEPENDENCY_EXPIRY_REQUIRED")
+        if any(not isinstance(k, str) or not k or not isinstance(v, str) or not v for k, v in deps.items()):
+            raise CheckpointError("INVALID_DEPENDENCIES")
+        if any(type(v) not in (int, float) or not math.isfinite(v) or v <= now for v in expiries.values()):
+            raise CheckpointError("EXPIRED_DEPENDENCY")
+        projects = tuple(sorted(set(project_ids)))
+        if any(not isinstance(p, str) or not p or len(p) > 256 for p in projects):
+            raise CheckpointError("INVALID_PROJECTS")
+        try:
+            value_json = canonical(value)
+            input_hash = digest(input_value)
+            deps_json, expires_json, projects_json = canonical(deps), canonical(expiries), canonical(projects)
+        except (TypeError, ValueError) as exc:
+            raise CheckpointError("CHECKPOINT_MUST_BE_JSON") from exc
+        if len((value_json + deps_json + expires_json + projects_json).encode("utf-8")) > self.max_bytes:
+            raise CheckpointError("CHECKPOINT_TOO_LARGE")
+        effective_expiry = min([expires_at, *expiries.values()])
+        with self._connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            old = db.execute("SELECT version FROM am_harness_checkpoints WHERE scope_key=? AND run_id=? AND phase=?",
+                             (scope_key, run_id, phase)).fetchone()
+            version = old[0] + 1 if old else 1
+            db.execute("""INSERT INTO am_harness_checkpoints VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)
+                ON CONFLICT(scope_key,run_id,phase) DO UPDATE SET
+                permission_fingerprint=excluded.permission_fingerprint,input_hash=excluded.input_hash,
+                dependencies_json=excluded.dependencies_json,dependency_expiries_json=excluded.dependency_expiries_json,
+                projects_json=excluded.projects_json,value_json=excluded.value_json,
+                expires_at=excluded.expires_at,created_at=excluded.created_at,
+                version=excluded.version,effect=excluded.effect""",
+                       (scope_key, permission_fingerprint, run_id, phase, input_hash,
+                        deps_json, expires_json, projects_json, value_json,
+                        effective_expiry, now, version, effect))
+        return Checkpoint(run_id, phase, json.loads(value_json), input_hash, deps, projects,
+                          effective_expiry, now, version, effect)
+
+    def get(self, *, scope_key: str, permission_fingerprint: str, run_id: str, phase: str,
+            input_value: Any, current_versions: Mapping[str, str | None],
+            authorize_project: Callable[[str], bool], revoked_sources: frozenset[str] = frozenset(),
+            current_expiries: Mapping[str, float] | None = None, now: float | None = None) -> Checkpoint | None:
+        self._identity(scope_key, run_id, phase, permission_fingerprint)
+        now = self._now(now)
+        with self._connect() as db:
+            row = db.execute("SELECT * FROM am_harness_checkpoints WHERE scope_key=? AND run_id=? AND phase=?",
+                             (scope_key, run_id, phase)).fetchone()
+        if row is None or row["expires_at"] <= now or row["permission_fingerprint"] != permission_fingerprint:
+            return None
+        if row["input_hash"] != digest(input_value) or row["effect"] not in {"read", "pure_local"}:
+            return None
+        deps = json.loads(row["dependencies_json"])
+        expiries = json.loads(row["dependency_expiries_json"])
+        projects = tuple(json.loads(row["projects_json"]))
+        if any(not authorize_project(project) for project in projects):
+            return None
+        for source_id, version in deps.items():
+            if source_id in revoked_sources or current_versions.get(source_id) != version or expiries[source_id] <= now:
+                return None
+            if current_expiries is not None:
+                expiry = current_expiries.get(source_id)
+                if type(expiry) not in (int, float) or not math.isfinite(expiry) or expiry <= now:
+                    return None
+        valid_until = row["expires_at"]
+        if current_expiries is not None and deps:
+            valid_until = min(valid_until, *(current_expiries[s] for s in deps))
+        return Checkpoint(run_id, phase, json.loads(row["value_json"]), row["input_hash"], deps,
+                          projects, valid_until, row["created_at"], row["version"], row["effect"])
+
+    def invalidate_sources(self, source_ids: Sequence[str]) -> int:
+        ids = set(source_ids)
+        if not ids:
+            return 0
+        with self._connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            keys = [(r["scope_key"], r["run_id"], r["phase"])
+                    for r in db.execute("SELECT scope_key,run_id,phase,dependencies_json FROM am_harness_checkpoints")
+                    if ids.intersection(json.loads(r["dependencies_json"]))]
+            db.executemany("DELETE FROM am_harness_checkpoints WHERE scope_key=? AND run_id=? AND phase=?", keys)
+            return len(keys)
+
+    def revoke_scope(self, scope_key: str) -> int:
+        with self._connect() as db:
+            return db.execute("DELETE FROM am_harness_checkpoints WHERE scope_key=?", (scope_key,)).rowcount
+
+    def purge_expired(self, *, now: float | None = None) -> int:
+        with self._connect() as db:
+            return db.execute("DELETE FROM am_harness_checkpoints WHERE expires_at<=?", (self._now(now),)).rowcount
