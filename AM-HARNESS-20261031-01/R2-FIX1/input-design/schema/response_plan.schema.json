{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:am-harness:response-plan:2.0-design.1",
  "title": "ResponsePlan body; outer CoordinatorModel type is response_plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_fingerprint",
    "segments",
    "omitted_optional_claim_ids"
  ],
  "properties": {
    "envelope_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text",
              "claim_ids",
              "intent"
            ],
            "properties": {
              "kind": {
                "const": "text"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 128,
                "uniqueItems": true
              },
              "intent": {
                "enum": [
                  "answer",
                  "analysis",
                  "recommendation",
                  "question",
                  "acknowledgement"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "block_id"
            ],
            "properties": {
              "kind": {
                "const": "locked"
              },
              "block_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        ]
      }
    },
    "omitted_optional_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 128,
      "uniqueItems": true
    }
  },
  "$comment": "Host validation additionally checks live bindings, dynamic budgets, receipts, required blocks and semantic risk. Provider adapters must validate supported schema subsets; this is the canonical host schema."
}
