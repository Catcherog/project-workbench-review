+            f"**B · 助手待审草案：**{r['candidates']['proposed_revision']['text']}", "",
+            "**待填写：**A/B 各自事实、语气、可直接采用；绝对认可的版本；可选偏好；修改意见。", "",
+            f"`{r['id']}`", ""])
+    return "\n".join(lines)
