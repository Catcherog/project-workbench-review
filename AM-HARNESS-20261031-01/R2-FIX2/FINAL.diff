+        e=p.envelope();assert len(e.data['required_claim_ids'])==len(e.data['allowed_omission_ids'])==1
+        plan=compact(e,[{'kind':'text','intent':'answer','text':'根据记录，测试尚未完成。','refs':[0]}],[1])
+        assert p.validate(plan,e,6000)[0]
+    finally:p.end(t)
