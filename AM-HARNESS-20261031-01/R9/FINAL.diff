+def public_fixture(bundle):
+    plan = {"planned_cases": 4, "planned_arms": 3, "planned_positions": 12,
+            "arms": deepcopy(bundle["plan"]["arms"]),
+            "plan_seal_sha256": bundle["plan"]["plan_sha256"],
