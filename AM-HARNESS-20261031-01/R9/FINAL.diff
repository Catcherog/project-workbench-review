+    # source revision and actual field values are, and remain in the binding.
+    return {k: project.get(k) for k in (
+        'key', 'title', 'business_id', 'identity_status', 'source_revision',
+        'content_fingerprint', 'fields', '关键日期', '待办', '项目进展', '人员与职责')}
