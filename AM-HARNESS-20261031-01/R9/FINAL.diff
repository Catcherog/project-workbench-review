+                ('source_id', 'stale', 'unprocessed_jobs', 'gap_kinds')}
+                for s in coverage.get('sources', [])), key=lambda s: s['source_id']),
+            **{k: coverage.get(k) for k in ('scope', 'processing_pending',
+                'needs_refresh_or_review', 'global_completeness_claim')}}})
