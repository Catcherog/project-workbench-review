+    add("r5-conflicting-records", 2, "传感项目已经结束测试了吗？",
+        [_statement("ledger", "传感项目台账状态仍为测试中"),
+         _statement("message", "一条工程师反馈称某台样件测试已经结束，但未说明是否覆盖全部样件"),
+         _statement("unresolved", "目前不能据此确认整个项目测试已结束")],
