+
+def _success(ident, kind, obj):
+    return {"id": ident, "kind": kind, "object": obj, "state": "succeeded",
+            "receipt": {"id": "synthetic-receipt:" + ident,
+                        "operation_id": "synthetic-operation:" + ident,
+                        "object_id": "synthetic-object:" + ident, "verified": True}}
