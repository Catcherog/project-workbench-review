+            for node in paragraph[:1024]:
+                tag = node.get('tag') if isinstance(node, dict) else None
+                tags.add(tag if isinstance(tag, str) and tag in known_tags else 'other')
+    result['post_node_types'] = sorted(tags)
+    return result
 
 
