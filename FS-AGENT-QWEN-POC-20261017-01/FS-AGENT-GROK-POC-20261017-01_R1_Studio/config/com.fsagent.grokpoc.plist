<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.fsagent.grokpoc</string>
  <key>UserName</key><string>_fsagent</string>
  <key>GroupName</key><string>_fsagent</string>
  <key>ProgramArguments</key><array>
    <string>/Library/FSAgentGrok/app/.venv/bin/python</string>
    <string>-m</string><string>fs_agent.cli</string><string>serve</string>
    <string>--config</string><string>/Library/FSAgentGrok/config/environment.json</string>
  </array>
  <key>WorkingDirectory</key><string>/Library/FSAgentGrok/home</string>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>/Library/FSAgentGrok/home</string><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>150</integer>
  <key>AbandonProcessGroup</key><false/>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Library/FSAgentGrok/state/service.log</string>
  <key>StandardErrorPath</key><string>/Library/FSAgentGrok/state/service.log</string>
</dict></plist>
