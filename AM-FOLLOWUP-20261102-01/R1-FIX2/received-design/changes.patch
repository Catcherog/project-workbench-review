+    n.am.step()
+    assert n.s.rows('SELECT kind FROM followup_reply_links WHERE message_id=?',(ident,))==[{'kind':'reported_update'}]
+    assert len(n.calls)==1 and n.am.items.get(item['id'])['state']=='waiting'
